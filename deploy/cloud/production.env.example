# Konfigurasi NON-SECRET production. Salin ke deploy/cloud/production.env
# (diabaikan Git) dan isi. Secret TIDAK ditulis di sini: setiap secret adalah
# berkas di deploy/cloud/secrets/<nama> (lihat README.md) dan dibaca lewat
# variabel <NAMA>_FILE oleh compose.production.yaml.
NODE_ENV=production

# PostgreSQL utama (satu database)
POSTGRES_DB=segaloka_production
POSTGRES_USER=segaloka_production_app
DB_SSL=false

# API bersama
PUBLIC_ORIGIN=https://api.segaloka.com
PUBLIC_CERTIFICATE_BASE_URL=https://api.segaloka.com
EMAIL_VERIFY_URL=https://segaloka.com/verifikasi-email
PASSWORD_RESET_URL=https://segaloka.com/reset-password
RESEND_FROM_EMAIL=no-reply@segaloka.com
# Alamat nginx di jaringan edge, agar X-Forwarded-For dipercaya hanya dari proxy.
TRUSTED_PROXY_IPS=

# Hostname publik (dipakai template nginx). Nama di bawah adalah contoh dan
# baru berlaku setelah DNS diarahkan; jangan ubah DNS production sebelum
# runtime tervalidasi.
SEGALOKA_API_HOST=api.segaloka.com
SEGALOKA_CONTROL_CENTER_HOST=control.dashboard.segaloka.com
SEGALOKA_TRAVEL_HOST=travel.dashboard.segaloka.com
SEGALOKA_VENDOR_HOST=vendor.dashboard.segaloka.com
SEGALOKA_AFFILIATE_HOST=affiliate.dashboard.segaloka.com
SEGALOKA_AGEN_HOST=agen.dashboard.segaloka.com
SEGALOKA_MITRA_HOST=mitra.dashboard.segaloka.com
SEGALOKA_TRAVELER_HOST=traveler.dashboard.segaloka.com

# Origin publik per dashboard (wajib https; harus sama dengan host di atas).
SEGALOKA_CONTROL_CENTER_PUBLIC_ORIGIN=https://control.dashboard.segaloka.com
SEGALOKA_TRAVEL_PUBLIC_ORIGIN=https://travel.dashboard.segaloka.com
SEGALOKA_VENDOR_PUBLIC_ORIGIN=https://vendor.dashboard.segaloka.com
SEGALOKA_AFFILIATE_PUBLIC_ORIGIN=https://affiliate.dashboard.segaloka.com
SEGALOKA_AGEN_PUBLIC_ORIGIN=https://agen.dashboard.segaloka.com
SEGALOKA_MITRA_PUBLIC_ORIGIN=https://mitra.dashboard.segaloka.com
SEGALOKA_TRAVELER_PUBLIC_ORIGIN=https://traveler.dashboard.segaloka.com

# Login enam dashboard non-admin hanya lewat Marketplace. Origin Marketplace
# yang boleh mengirim form POST handoff ke /bff/auth/handoff/callback
# (production: hanya https://segaloka.com atau https://www.segaloka.com).
SEGALOKA_MARKETPLACE_ORIGIN=https://www.segaloka.com
