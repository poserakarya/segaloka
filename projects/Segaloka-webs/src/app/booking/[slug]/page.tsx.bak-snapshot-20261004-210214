import {
  BookingFormClient,
} from "@/components/booking/BookingFormClient";


type BookingPageProps = {
  params: Promise<{
    slug: string;
  }>;

  searchParams: Promise<{
    adult?: string;
    child?: string;
    infant?: string;
  }>;
};


function parseTravelerCount(
  value: string | undefined,
  fallback: number,
) {
  if (
    value === undefined ||
    value.trim() === ""
  ) {
    return fallback;
  }

  const parsed =
    Number.parseInt(
      value,
      10,
    );

  if (
    !Number.isFinite(parsed) ||
    parsed < 0
  ) {
    return fallback;
  }

  return parsed;
}


export default async function BookingPage({
  params,
  searchParams,
}: BookingPageProps) {

  const {
    slug,
  } =
    await params;

  const query =
    await searchParams;

  const adult =
    Math.max(
      1,
      parseTravelerCount(
        query.adult,
        1,
      ),
    );

  const child =
    parseTravelerCount(
      query.child,
      0,
    );

  const infant =
    parseTravelerCount(
      query.infant,
      0,
    );


  return (
    <BookingFormClient
      slug={slug}
      adult={adult}
      child={child}
      infant={infant}
    />
  );
}