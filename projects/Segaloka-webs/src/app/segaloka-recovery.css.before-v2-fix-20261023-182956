/* sg-recovery-reference-v1 */
/* Hanya berlaku untuk modal pemulihan akun Segaloka */

.sg-recovery-modal-active .sg-auth-modal {
  width: min(616px, calc(100vw - 32px));
  max-width: 616px;
  border-radius: 22px;
  padding: 34px 42px 38px;
  background: #fff;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.sg-recovery-modal-active .sg-auth-login-flow {
  width: 100%;
}

.sg-recovery-modal-active .sg-auth-login-form,
.sg-recovery-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.sg-recovery-modal-active h2,
.sg-recovery-content h2 {
  color: #09244c;
  font-size: clamp(26px, 3vw, 36px);
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.sg-recovery-description {
  color: #70809a;
  text-align: center;
  font-size: 17px;
  line-height: 1.65;
  margin: 0 0 20px;
}

.sg-recovery-content label,
.sg-recovery-modal-active .sg-auth-login-form label {
  color: #10274a;
  font-size: 16px;
  font-weight: 700;
}

.sg-recovery-modal-active input,
.sg-recovery-phone-field {
  min-height: 62px;
  border: 1.5px solid #cbd6e5;
  border-radius: 13px;
  background: #fff;
  font-size: 16px;
}

.sg-recovery-phone-field {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 0 20px;
}

.sg-recovery-phone-field input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
}

.sg-recovery-primary,
.sg-recovery-modal-active .sg-auth-login-form button[type="submit"] {
  width: 100%;
  min-height: 66px;
  border: none;
  border-radius: 12px;
  background: #10478d;
  color: white;
  font-size: 17px;
  font-weight: 750;
  cursor: pointer;
}

.sg-recovery-primary:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.sg-recovery-security {
  background: #edf4ff;
  border-radius: 14px;
  padding: 22px;
  color: #123568;
  font-size: 15px;
  line-height: 1.6;
}

.sg-recovery-security p {
  margin: 7px 0 0;
}

.sg-recovery-back {
  align-self: center;
  border: 0;
  background: transparent;
  color: #0875f9;
  font-size: 17px;
  font-weight: 700;
  margin-top: 18px;
  cursor: pointer;
}

@media (max-width: 640px) {
  .sg-recovery-modal-active .sg-auth-modal {
    width: calc(100vw - 24px);
    padding: 26px 22px;
    border-radius: 20px;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
  }

  .sg-recovery-description {
    font-size: 14px;
  }

  .sg-recovery-modal-active input,
  .sg-recovery-phone-field {
    min-height: 54px;
  }

  .sg-recovery-primary,
  .sg-recovery-modal-active .sg-auth-login-form button[type="submit"] {
    min-height: 56px;
  }
}