                    </section>

                    <section>
                      <h2>Tidak Termasuk</h2>

                      {product.excludes.map((item) => (
                        <span key={item}>
                          <CircleX size={14} />
                          {item}
                        </span>
                      ))}
                    </section>
                  </div>
                )}

                {activeTab === "policy" && (
                  <div className="la-policy">
                    <h2>Kebijakan Produk</h2>

                    <p>
                      Ketentuan pembatalan, perubahan jadwal, refund, batas
                      waktu pembayaran, dan dokumen perjalanan mengikuti
                      kebijakan produk yang ditetapkan Travel atau Vendor pada
                      saat pemesanan.
                    </p>

                    <p>
                      Rincian final harus ditampilkan sebelum pelanggan
                      melakukan pembayaran.
                    </p>
                  </div>
                )}
              </div>
            </div>
          </div>

          <aside className="la-booking-card">
            <div className="la-booking-price">
              <small>Mulai dari</small>
              <div>
                <strong>{formatRupiah(pricePerPax)}</strong>
                <span>/ pax</span>
              </div>
            </div>

            <div className="la-selected-room">
              <BedDouble size={17} />

              <div>
                <small>Tipe kamar</small>
                <strong>{roomLabel(roomType)}</strong>
              </div>

              <span>{capacity} pax/kamar</span>
            </div>

            <div className="la-booking-field la-period-field">
              <span>Periode Perjalanan</span>

              <div className="la-period-options">
                {periods.map((period) => {
                  const unavailable =
                    period.status !== "AVAILABLE" ||
                    period.remainingQuota <= 0;

                  const selected =
                    selectedPeriodId === period.id;

                  return (
                    <button
                      key={period.id}
                      type="button"
                      className={`la-period-option ${
                        selected ? "active" : ""
                      }`}
                      disabled={unavailable}
                      onClick={() => {
                        setSelectedPeriodId(period.id);
                        setRoomType("quad");
                        setRooms(1);
                      }}
                    >
                      <div className="la-period-calendar">
                        <CalendarDays size={17} />
                      </div>

                      <div className="la-period-copy">
                        <strong>
                          {formatPeriodDate(period.startDate)}
                          <ChevronRight size={12} />
                          {formatPeriodDate(period.endDate)}
                        </strong>

                        <span>
                          Batas pesan{" "}
                          {formatPeriodDate(period.bookingDeadline)}
                        </span>
                      </div>

                      <div
                        className={`la-period-status ${
                          unavailable ? "sold-out" : ""
                        }`}
                      >
                        {periodStatusLabel(period)}
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            <div className="la-booking-field">
              <span>Jumlah Kamar</span>

              <div className="la-traveler-control">
                <BedDouble size={17} />

                <button
                  type="button"
                  aria-label="Kurangi jumlah kamar"
                  onClick={() =>
                    setRooms((value) => Math.max(1, value - 1))
                  }
                  disabled={rooms <= 1}
                >
                  <Minus size={14} />
                </button>

                <strong>{rooms} kamar</strong>

                <button
                  type="button"
                  aria-label="Tambah jumlah kamar"
                  onClick={() =>
                    setRooms((value) =>
                      Math.min(
                        Math.max(1, maxRoomsByQuota),
                        value + 1,
                      ),
                    )
                  }
                  disabled={
                    !selectedPeriod ||
                    maxRoomsByQuota <= 0 ||
                    rooms >= maxRoomsByQuota
                  }
                >
                  <Plus size={14} />
                </button>
              </div>
            </div>

            <div className="la-booking-summary">
              {selectedPeriod && (
                <div>
                  <CalendarDays size={15} />
                  <span>Periode</span>
                  <strong>
                    {formatPeriodDate(selectedPeriod.startDate)}
                    {" – "}
                    {formatPeriodDate(selectedPeriod.endDate)}
                  </strong>
                </div>
              )}

              <div>
                <Users size={15} />
                <span>Total traveler</span>
                <strong>{traveler} orang</strong>
              </div>

              <div>
                <BedDouble size={15} />
                <span>Konfigurasi</span>
                <strong>
                  {rooms} {roomLabel(roomType)}
                </strong>
              </div>
            </div>

            <div className="la-price-breakdown">
              <div>
                <span>
                  {formatRupiah(pricePerPax)} × {traveler} pax
                </span>
                <strong>{formatRupiah(total)}</strong>
              </div>
            </div>

            <div className="la-total">
              <span>Total Harga</span>
              <strong>{formatRupiah(total)}</strong>
            </div>

            <small className="la-total-note">
              Harga mengikuti periode, tipe kamar, jumlah kamar, dan kuota yang ditetapkan Travel/Vendor.
            </small>

            <button
              type="button"
              className="la-booking-button"
              onClick={continueBooking}
              disabled={!periodCanBook}
            >
              Lanjut Pemesanan
              <ChevronRight size={16} />
            </button>

            {!selectedPeriod && (
              <small className="la-date-note">
                Pilih periode perjalanan yang disediakan Travel/Vendor.
              </small>
            )}

            {selectedPeriod && !periodCanBook && (
              <small className="la-date-note la-date-note-error">
                Kuota traveler atau kamar untuk pilihan ini tidak mencukupi.
              </small>
            )}

            <div className="la-booking-assurance">
              <ShieldCheck size={15} />
              <span>
                Detail harga dan komponen produk akan ditinjau kembali sebelum
                pembayaran.
              </span>
            </div>
          </aside>
        </section>
      </div>
    </main>
  );
}