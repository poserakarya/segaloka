function getPrototypePeriods(
  product: AccommodationProduct,
): AccommodationPeriod[] {
  const existing = prototypePeriods[product.slug];

  if (existing) {
    return existing;
  }

  /*
   * Produk lain tetap diberi satu periode prototype agar UI dapat diuji.
   * Saat dashboard Vendor/Travel aktif, fallback ini dihapus dan seluruh
   * periode wajib berasal dari data produk.
   */
  return [
    {
      id: `${product.slug}-2026-12-10`,
      startDate: "2026-12-10",
      endDate: "2026-12-10",
      bookingDeadline: "2026-12-05",
      quota: 20,
      remainingQuota: 20,
      status: "AVAILABLE",
      rooms: {
        quad: {
          pricePerPax: product.price,
          availableRooms: 5,
        },
        triple: {
          pricePerPax: product.price,
          availableRooms: 5,
        },
        double: {
          pricePerPax: product.price,
          availableRooms: 5,
        },
      },
    },
  ];
}

function formatPeriodDate(value: string) {
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(new Date(`${value}T00:00:00`));
}

function periodStatusLabel(period: AccommodationPeriod) {
  if (
    period.status === "SOLD_OUT" ||
    period.remainingQuota <= 0
  ) {
    return "Habis";
  }

  if (period.status === "CLOSED") {
    return "Ditutup";
  }

  return "Tersedia";
}
