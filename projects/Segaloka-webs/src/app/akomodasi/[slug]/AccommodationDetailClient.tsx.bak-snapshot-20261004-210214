function formatRupiah(value: number) {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);
}

function roomCapacity(roomType: RoomType) {
  if (roomType === "double") return 2;
  if (roomType === "triple") return 3;
  return 4;
}

function roomLabel(roomType: RoomType) {
  if (roomType === "double") return "Double";
  if (roomType === "triple") return "Triple";
  return "Quad";
}



