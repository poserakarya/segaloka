/* SEGALOKA ARABIC RTL PHASE 1 START */

/*
 * RTL hanya aktif ketika global MarketplacePreferencesProvider
 * menetapkan dir="rtl" pada <html>.
 *
 * Tidak mengubah geometry ID / EN.
 * Tidak mengubah centering hero-controls.
 */

html[dir="rtl"] body {
  direction: rtl;
}

/* Header */
html[dir="rtl"] .hero-header-shell {
  direction: rtl;
}

html[dir="rtl"] .hero-nav-new,
html[dir="rtl"] .hero-header-actions {
  direction: rtl;
}

/*
 * Dropdown harus mengikuti inline-end.
 * Override rule desktop lama yang memaksa right:0.
 */
html[dir="rtl"] .hero-nav-dropdown .hero-nav-menu {
  left: 0 !important;
  right: auto !important;
}

/* Search / Hero */
html[dir="rtl"] .hero-search-card,
html[dir="rtl"] .hero-field,
html[dir="rtl"] .hero-popover {
  direction: rtl;
}

html[dir="rtl"] .hero-field-content {
  text-align: start;
}

/*
 * Jangan mirror hero-controls.
 * left:50% + translateX(-50%) adalah centering,
 * bukan positioning LTR.
 */

/* Form controls */
html[dir="rtl"] input,
html[dir="rtl"] textarea,
html[dir="rtl"] select {
  text-align: start;
}

/*
 * Nilai numerik, kode mata uang, harga, tanggal numerik,
 * nomor penerbangan dan data sejenis tidak boleh dibalik
 * oleh Unicode bidi.
 */
html[dir="rtl"] .marketplace-price,
html[dir="rtl"] .product-price,
html[dir="rtl"] [data-currency],
html[dir="rtl"] [data-price] {
  direction: ltr;
  unicode-bidi: isolate;
}

/* Home cards */
html[dir="rtl"] .ref-package-body,
html[dir="rtl"] .reference-coupon-copy,
html[dir="rtl"] .reference-promo-content,
html[dir="rtl"] .ref-section-title {
  text-align: start;
}

/* Footer */
html[dir="rtl"] .footer,
html[dir="rtl"] .footer-grid,
html[dir="rtl"] .footer-bottom {
  direction: rtl;
}

html[dir="rtl"] .footer {
  text-align: start;
}

/*
 * Icon + text tetap natural.
 * Flex direction mengikuti RTL tanpa melakukan transform/mirror icon.
 */
html[dir="rtl"] .hero-nav-trigger,
html[dir="rtl"] .hero-currency,
html[dir="rtl"] .hero-login,
html[dir="rtl"] .hero-register {
  direction: rtl;
}

/* Jangan mirror gambar, logo, foto, dan icon SVG. */
html[dir="rtl"] img,
html[dir="rtl"] svg {
  transform: none;
}

/* SEGALOKA ARABIC RTL PHASE 1 END */

