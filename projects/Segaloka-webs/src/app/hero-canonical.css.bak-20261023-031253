/* ============================================================
   CATEGORY TABS
   ============================================================ */

.hero-tabs {
  position: relative;

  z-index: 52;

  width: max-content;
  max-width: 100%;

  margin: 0 auto;

  padding: 8px 10px;

  display: flex;
  align-items: center;

  gap: 6px;

  overflow-x: auto;
  overflow-y: hidden;

  border: 1px solid var(--sg-border);
  border-radius: 999px;

  background: #ffffff;

  box-shadow:
    0 10px 28px rgba(30, 75, 120, .14);

  scrollbar-width: none;
}

.hero-tabs::-webkit-scrollbar {
  display: none;
}

.hero-tabs button {
  min-width: max-content;
  height: 42px;

  padding: 0 13px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  border: 0;
  border-radius: 999px;

  background: transparent;

  color: #17365e;

  font-family:
    var(--font-jakarta),
    "Plus Jakarta Sans",
    Arial,
    sans-serif;

  font-size: 12px;
  line-height: 1;

  font-weight: 650;

  white-space: nowrap;
}

.hero-tab-icon {
  width: 28px;
  height: 28px;

  flex: 0 0 28px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: var(--sg-blue);

  background: #edf6ff;
}

.hero-tabs button.active,
.hero-tabs button[aria-selected="true"] {
  color: var(--sg-blue);

  background: #edf6ff;
}

.hero-tabs button.active .hero-tab-icon,
.hero-tabs button[aria-selected="true"] .hero-tab-icon {
  color: #ffffff;

  background: var(--sg-blue);
}


