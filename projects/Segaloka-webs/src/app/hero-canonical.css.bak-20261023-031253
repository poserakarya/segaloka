/* ============================================================
   GRID UTAMA
   ============================================================ */

.pkgd-top-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 250px;
  gap: 13px;
  align-items: start;
}

.pkgd-left {
  min-width: 0;
  padding: 7px;
  border-radius: 14px;
  background: #efefef;
}


/* ============================================================
   GALLERY
   ============================================================ */

.pkgd-gallery {
  height: 245px;
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 7px;
}

.pkgd-gallery-main,
.pkgd-gallery-wide,
.pkgd-gallery-bottom > div {
  position: relative;
  overflow: hidden;
  border: 1px solid #d7e2ec;
  border-radius: 9px;
  background: #eaf4fa;
}

.pkgd-gallery-main {
  border-color: #0878f9;
}

.pkgd-gallery img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.pkgd-gallery-side {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 7px;
}

.pkgd-gallery-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.pkgd-gallery-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0) 45%,
      rgba(10,34,62,.74) 100%
    );
}

.pkgd-gallery-caption {
  position: absolute;
  left: 9px;
  bottom: 8px;
  z-index: 2;
  color: #ffffff;
}

.pkgd-gallery-caption strong {
  display: block;
  font-size: 10px;
  line-height: 1.1;
}

.pkgd-gallery-caption span {
  display: block;
  margin-top: 2px;
  font-size: 7px;
}


/* ============================================================
   TABS
   ============================================================ */

.pkgd-tabs {
  margin-top: 7px;
  overflow: hidden;
  border-radius: 9px;
  background: #ffffff;
}

.pkgd-tab-nav {
  height: 40px;
  padding: 0 10px;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  border-bottom: 1px solid #d9e0e7;
}

.pkgd-tab-nav button {
  position: relative;
  border: 0;
  background: transparent;
  color: #183654;
  font-family: inherit;
  font-size: 8px;
  font-weight: 500;
  cursor: pointer;
}

.pkgd-tab-nav button::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: -1px;
  height: 2px;
  background: transparent;
}

.pkgd-tab-nav button.active {
  color: #0878f9;
}

.pkgd-tab-nav button.active::after {
  background: #0878f9;
}

.pkgd-tab-panel {
  position: relative;
  height: 142px;
  overflow: hidden;
  color: #183654;
}

.pkgd-description,
.pkgd-facilities,
.pkgd-policy,
.pkgd-review,
.pkgd-itinerary,
.pkgd-ticket {
  height: 100%;
  padding: 14px;
}

.pkgd-description {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 12px;
  overflow-y: auto;
}

.pkgd-description > strong,
.pkgd-facilities > strong,
.pkgd-policy > strong {
  font-size: 9px;
}

.pkgd-description p {
  margin: 0;
  color: #304b68;
  font-size: 9px;
  line-height: 1.55;
}

.pkgd-itinerary,
.pkgd-ticket {
  position: relative;
}

.pkgd-itinerary-content {
  display: grid;
  grid-template-columns: 66px 1fr;
  gap: 12px;
}

.pkgd-itinerary-content strong {
  font-size: 9px;
}

.pkgd-itinerary-content p {
  margin: 0;
  color: #304b68;
  font-size: 9px;
  line-height: 1.55;
}

.pkgd-pager {
  position: absolute;
  left: 14px;
  bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pkgd-pager button {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  border: 1px solid #0878f9;
  border-radius: 50%;
  background: #ffffff;
  color: #0878f9;
}

.pkgd-pager button:disabled {
  border-color: #b3bfcb;
  color: #8797a8;
}

.pkgd-pager span {
  color: #60758c;
  font-size: 8px;
}

.pkgd-facilities {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 12px;
}

.pkgd-facilities > div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 30px;
  align-content: start;
}

.pkgd-facilities span {
  color: #304b68;
  font-size: 9px;
}

.pkgd-policy {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 12px;
  overflow-y: auto;
}

.pkgd-policy ol {
  margin: 0;
  padding-left: 14px;
  color: #304b68;
  font-size: 9px;
  line-height: 1.6;
}

.pkgd-review {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 12px;
}

.pkgd-review > div:first-child > strong {
  display: block;
  font-size: 11px;
}

.pkgd-review > div:first-child span {
  display: block;
  margin-top: 5px;
  color: #75879b;
  font-size: 8px;
  line-height: 1.45;
}

.pkgd-review p {
  margin: 0;
  color: #304b68;
  font-size: 9px;
  line-height: 1.55;
}

.pkgd-review > div:last-child > strong {
  display: block;
  margin-top: 8px;
  font-size: 8px;
}

.pkgd-hotel {
  display: grid;
  grid-template-columns: 55px 1fr 155px;
  gap: 12px;
}

.pkgd-hotel > strong {
  font-size: 9px;
}

.pkgd-hotel > div > b {
  display: block;
  font-size: 9px;
}

.pkgd-hotel > div > span {
  display: block;
  margin-top: 6px;
  color: #8090a2;
  font-size: 8px;
}

.pkgd-hotel p {
  margin: 6px 0 0;
  color: #304b68;
  font-size: 8px;
  line-height: 1.45;
}

.pkgd-hotel aside {
  height: 82px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 8px;
  border: 1px solid #d2e1ec;
  border-radius: 11px;
  background:
    linear-gradient(
      135deg,
      #e9f4ff,
      #edf9f4
    );
  color: #0878f9;
}

.pkgd-hotel aside button {
  padding: 5px 8px;
  border: 0;
  border-radius: 999px;
  background: #ffffff;
  color: #0878f9;
  font-size: 7px;
}

.pkgd-flight {
  display: grid;
  grid-template-columns: 55px 1fr;
  gap: 12px;
}

.pkgd-flight > strong {
  font-size: 9px;
}

.pkgd-flight-card {
  padding-left: 10px;
  border-left: 1px solid #e1e6eb;
}

.pkgd-flight-card header {
  display: flex;
  align-items: center;
  gap: 5px;
}

.pkgd-flight-card header > strong,
.pkgd-flight-card header > b {
  font-size: 8px;
}

.pkgd-flight-card header > span {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #008ca3;
  color: white;
  font-size: 7px;
}

.pkgd-flight-card header > small {
  margin-left: auto;
  color: #76899d;
  font-size: 7px;
}

.pkgd-flight-card > div {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1fr 90px 1fr;
  align-items: center;
}

.pkgd-flight-card section strong {
  display: block;
  font-size: 17px;
  font-weight: 500;
}

.pkgd-flight-card section span {
  font-size: 8px;
}

.pkgd-flight-card section:last-child {
  text-align: right;
}

.pkgd-flight-middle {
  display: grid;
  justify-items: center;
  gap: 5px;
  color: #0878f9;
}


/* ============================================================
   BOOKING
   ============================================================ */

.pkgd-booking {
  position: sticky;
  top: 82px;
  overflow: hidden;
  border-radius: 13px;
  background: #eeeeee;
  box-shadow: 0 8px 22px rgba(20,53,84,.08);
}

.pkgd-booking > section {
  margin-left: 7px;
  margin-right: 7px;
  background: #ffffff;
}

.pkgd-booking-price {
  position: relative;
  margin-top: 7px;
  padding: 10px;
  border: 1px solid #d7e1ea;
  border-radius: 9px;
}

.pkgd-booking-date {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding-bottom: 9px;
  border-bottom: 1px solid #e2e8ee;
}

.pkgd-booking-date > div:last-child {
  text-align: right;
}

.pkgd-booking-date strong,
.pkgd-booking-date span {
  display: block;
}

.pkgd-booking-date strong {
  color: #405875;
  font-size: 8px;
}

.pkgd-booking-date span {
  color: #71859b;
  font-size: 7px;
}

.pkgd-booking-date > div:nth-child(2) {
  display: flex;
  align-items: center;
  color: #0878f9;
  font-size: 7px;
}

.pkgd-price-toggle {
  width: 100%;
  margin-top: 8px;
  padding: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.pkgd-price-toggle del {
  display: block;
  color: #9aa7b5;
  font-size: 7px;
}

.pkgd-price-toggle strong {
  color: #0878f9;
  font-size: 16px;
}

.pkgd-price-toggle span {
  margin-left: 2px;
  color: #23415f;
  font-size: 8px;
}

.pkgd-price-toggle svg {
  transition: transform .18s ease;
}

.pkgd-price-toggle svg.open {
  transform: rotate(180deg);
}

.pkgd-price-dropdown {
  margin-top: 8px;
  padding-top: 6px;
  display: grid;
  border-top: 1px solid #e2e8ee;
}

.pkgd-price-dropdown button {
  min-height: 38px;
  padding: 5px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-bottom: 1px solid #edf1f4;
  background: transparent;
  font-family: inherit;
}

.pkgd-price-dropdown button:last-child {
  border-bottom: 0;
}

.pkgd-price-dropdown span {
  color: #74869a;
  font-size: 8px;
}

.pkgd-price-dropdown strong {
  color: #173c63;
  font-size: 9px;
}

.pkgd-price-dropdown small {
  font-size: 7px;
  font-weight: 500;
}

.pkgd-participants {
  margin-top: 7px;
  padding: 10px;
  border: 1px solid #d7e1ea;
  border-radius: 9px 9px 0 0;
}

.pkgd-participants h3,
.pkgd-price-detail h3 {
  margin: 0 0 7px;
  font-size: 9px;
}

.pkgd-participant-row {
  min-height: 29px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pkgd-participant-row > div:first-child {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.pkgd-participant-row > div:first-child strong {
  font-size: 8px;
}

.pkgd-participant-row > div:first-child span {
  color: #8392a5;
  font-size: 7px;
}

.pkgd-counter {
  display: grid;
  grid-template-columns: 19px 18px 19px;
  gap: 3px;
  align-items: center;
}

.pkgd-counter button {
  width: 19px;
  height: 19px;
  display: grid;
  place-items: center;
  border: 1px solid #d4dfe9;
  border-radius: 4px;
  background: #ffffff;
  color: #7890a7;
}

.pkgd-counter button:last-child {
  border-color: #0878f9;
  background: #0878f9;
  color: #ffffff;
}

.pkgd-counter strong {
  text-align: center;
  font-size: 8px;
}

.pkgd-price-detail {
  margin-top: 0;
  padding: 10px;
  border: 1px solid #d7e1ea;
  border-top: 0;
}

.pkgd-price-detail > div {
  min-height: 21px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 8px;
}

.pkgd-price-detail strong {
  font-size: 8px;
  font-weight: 500;
}

.pkgd-discount,
.pkgd-discount strong {
  color: #ff8b00;
}

.pkgd-voucher span {
  color: #00a1aa;
}

.pkgd-voucher input {
  width: 68px;
  height: 23px;
  border: 1px solid #d7e1ea;
  border-radius: 4px;
  text-align: center;
  color: #1f3b59;
  font-size: 7px;
  font-weight: 700;
}

.pkgd-total {
  margin-top: 0;
  padding: 9px 10px;
  display: flex;
  justify-content: space-between;
  border: 1px solid #d7e1ea;
  border-top: 0;
  border-radius: 0 0 9px 9px;
}

.pkgd-total strong {
  font-size: 8px;
}

.pkgd-continue {
  width: calc(100% - 14px);
  height: 39px;
  margin: 7px;
  border: 0;
  border-radius: 8px;
  background: #0878f9;
  color: #ffffff;
  font-family: inherit;
  font-size: 9px;
  font-weight: 800;
}


/* ============================================================
   ADS
   ============================================================ */

.pkgd-ad {
  position: relative;
  min-height: 92px;
  margin-top: 16px;
  padding: 15px 175px 15px 18px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 10px;
  background:
    linear-gradient(
      120deg,
      #0878f9 0%,
      #118cff 62%,
      #59b7ff 100%
    );
  color: #ffffff;
}

.pkgd-ad::before {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  right: 130px;
  top: -150px;
  border-radius: 50%;
  background: rgba(255,255,255,.10);
}

.pkgd-ad > div:first-child {
  position: relative;
  z-index: 2;
}

.pkgd-ad > div:first-child > small {
  display: block;
  color: #ffe044;
  font-size: 7px;
  font-weight: 800;
}

.pkgd-ad > div:first-child > strong {
  display: block;
  margin-top: 3px;
  font-size: 13px;
}

.pkgd-ad p {
  margin: 4px 0 0;
  color: rgba(255,255,255,.88);
  font-size: 7px;
}

.pkgd-ad-badge {
  position: absolute;
  z-index: 2;
  right: 79px;
  width: 57px;
  height: 57px;
  display: grid;
  place-items: center;
  align-content: center;
  border-radius: 50%;
  background: #ffd82e;
  color: #075cb8;
  text-align: center;
  transform: rotate(-8deg);
}

.pkgd-ad-badge small {
  font-size: 6px;
  font-weight: 800;
}

.pkgd-ad-badge strong {
  font-size: 8px;
  line-height: 1.05;
}

.pkgd-ad > button {
  position: absolute;
  z-index: 2;
  right: 12px;
  min-height: 29px;
  padding: 0 9px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  border: 0;
  border-radius: 7px;
  background: #ffffff;
  color: #0878f9;
  font-family: inherit;
  font-size: 7px;
  font-weight: 800;
}


/* ============================================================
   REKOMENDASI
   ============================================================ */

.pkgd-recommendations {
  margin-top: 17px;
}

.pkgd-recommendations header h2 {
  margin: 0;
  color: #102e55;
  font-size: 14px;
}

.pkgd-recommendations header p {
  margin: 4px 0 0;
  color: #76899c;
  font-size: 8px;
}

.pkgd-rec-grid {
  margin-top: 9px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 9px;
}

.pkgd-rec-card {
  overflow: hidden;
  border: 1px solid #dce6ef;
  border-radius: 12px;
  background: #ffffff;
  color: inherit;
  text-decoration: none;
}

.pkgd-rec-image {
  position: relative;
  height: 114px;
}

.pkgd-rec-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pkgd-rec-image > span {
  position: absolute;
  left: 8px;
  top: 8px;
  padding: 4px 7px;
  border-radius: 999px;
  background: rgba(255,255,255,.95);
  color: #17466e;
  font-size: 7px;
  font-weight: 800;
}

.pkgd-rec-image > small {
  position: absolute;
  left: 8px;
  bottom: 8px;
  padding: 4px 7px;
  display: inline-flex;
  align-items: center;
  gap: 2px;
  border-radius: 999px;
  background: #173e6c;
  color: #ffffff;
  font-size: 7px;
  font-weight: 800;
}

.pkgd-rec-image > small svg {
  color: #ffbd1f;
}

.pkgd-rec-body {
  padding: 9px;
}

.pkgd-rec-body > small {
  color: #647991;
  font-size: 7px;
}

.pkgd-rec-body h3 {
  min-height: 26px;
  margin: 4px 0 0;
  color: #153758;
  font-size: 9px;
  line-height: 1.35;
}

.pkgd-rec-meta {
  margin-top: 13px;
  padding-bottom: 7px;
  display: flex;
  gap: 6px;
  border-bottom: 1px solid #e5ebf0;
}

.pkgd-rec-meta span {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: #7990a7;
  font-size: 6px;
}

.pkgd-rec-price {
  padding-top: 7px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.pkgd-rec-price small {
  display: block;
  color: #8494a5;
  font-size: 6px;
}

.pkgd-rec-price strong {
  display: block;
  margin-top: 2px;
  color: #0878f9;
  font-size: 12px;
}

.pkgd-rec-price > span {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #edf5ff;
  color: #0878f9;
}

.pkgd-dots {
  margin-top: 11px;
  display: flex;
  justify-content: center;
  gap: 4px;
}

.pkgd-dots span {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #9cabb9;
}

.pkgd-dots span.active {
  background: #0878f9;
}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 900px) {

  .pkgd-shell {
    width: min(760px, calc(100% - 24px));
  }

  .pkgd-top-grid {
    grid-template-columns: 1fr;
  }

  .pkgd-booking {
    position: static;
  }

  .pkgd-rec-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 620px) {

  .pkgd-page {
    padding-top: 8px;
  }

  .pkgd-shell {
    width: calc(100% - 18px);
  }

  .pkgd-title h1 {
    font-size: 18px;
  }

  .pkgd-title-actions {
    display: none;
  }

  .pkgd-left {
    padding: 6px;
  }

  .pkgd-gallery {
    height: auto;
    display: block;
  }

  .pkgd-gallery-main {
    height: 225px;
  }

  .pkgd-gallery-side {
    margin-top: 6px;
    grid-template-rows: 80px 70px;
  }

  .pkgd-gallery-bottom {
    gap: 6px;
  }

  .pkgd-tab-nav {
    display: flex;
    overflow-x: auto;
  }

  .pkgd-tab-nav button {
    min-width: 86px;
  }

  .pkgd-tab-panel {
    height: 190px;
  }

  .pkgd-description,
  .pkgd-facilities,
  .pkgd-policy,
  .pkgd-review {
    grid-template-columns: 1fr;
    gap: 7px;
  }

  .pkgd-facilities > div {
    grid-template-columns: 1fr 1fr;
  }

  .pkgd-hotel {
    grid-template-columns: 1fr;
  }

  .pkgd-hotel aside {
    display: none;
  }

  .pkgd-flight {
    grid-template-columns: 1fr;
  }

  .pkgd-flight-card {
    padding-left: 0;
    border-left: 0;
  }

  .pkgd-ad {
    min-height: 112px;
    padding: 13px 82px 13px 13px;
  }

  .pkgd-ad > div:first-child > strong {
    font-size: 11px;
  }

  .pkgd-ad-badge {
    right: 10px;
    top: 9px;
    width: 52px;
    height: 52px;
  }

  .pkgd-ad > button {
    right: 9px;
    bottom: 9px;
  }

  .pkgd-rec-grid {
    grid-template-columns: 1fr;
  }

  .pkgd-rec-card {
    display: grid;
    grid-template-columns: 105px 1fr;
  }

  .pkgd-rec-image {
    height: 100%;
    min-height: 116px;
  }

}

