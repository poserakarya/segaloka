   ============================================================ */

.travel-ad-slider {
  position: relative;

  width: 100%;
}


.travel-ad-slider-shell {
  position: relative;

  overflow: hidden !important;
}


.travel-ad-slides {
  position: relative;

  width: 100%;

  /*
   * Mengikuti tinggi banner existing.
   */
  aspect-ratio: 1180 / 145;

  overflow: hidden;

  border-radius: inherit;
}


/* ============================================================
   SLIDE
   ============================================================ */

.travel-ad-slide {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  padding: 0;

  border: 0;
  border-radius: inherit;

  overflow: hidden;

  background: transparent;

  opacity: 0;

  visibility: hidden;

  transform:
    translateX(18px)
    scale(.995);

  cursor: pointer;

  pointer-events: none;

  transition:
    opacity .45s ease,
    transform .45s ease,
    visibility .45s ease;
}


.travel-ad-slide.active {
  opacity: 1;

  visibility: visible;

  transform:
    translateX(0)
    scale(1);

  pointer-events: auto;
}


.travel-ad-slide img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: inherit;
}


/* ============================================================
   DOTS
   ============================================================ */

.travel-ad-dots {
  position: absolute;

  left: 50%;
  bottom: 9px;

  z-index: 8;

  display: flex;
  align-items: center;

  gap: 5px;

  transform: translateX(-50%);
}


.travel-ad-dots button {
  width: 6px;
  height: 6px;

  padding: 0;

  border: 0;
  border-radius: 999px;

  background:
    rgba(255, 255, 255, .62);

  box-shadow:
    0 1px 4px
    rgba(0, 0, 0, .18);

  cursor: pointer;

  transition:
    width .2s ease,
    background .2s ease;
}


.travel-ad-dots button.active {
  width: 18px;

  background: #ffffff;
}


