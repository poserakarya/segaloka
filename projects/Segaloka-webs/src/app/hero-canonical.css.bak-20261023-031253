.hero-search-card {
  width: 100%;
  max-width: none;

  margin: 0;

  padding: 12px;

  display: grid;

  /*
   * Dari = Tujuan
   * Traveler lebih kecil
   * Tanggal proporsional
   * Cari fixed
   */
  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr)
    minmax(155px, .70fr)
    minmax(175px, .82fr)
    108px;

  gap: 10px;

  border: 1px solid var(--sg-border);
  border-radius: 18px;

  background: #ffffff;

  box-shadow:
    0 14px 34px rgba(31, 73, 116, .17);
}

.hero-field {
  min-width: 0;
  height: 58px;

  padding: 8px 11px;

  display: grid;

  grid-template-columns:
    auto
    minmax(0, 1fr)
    auto;

  align-items: center;

  gap: 9px;

  border: 1px solid #dce6f0;
  border-radius: 12px;

  background: #ffffff;

  color: #70829a;

  text-align: left;
}

.hero-field-icon {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  color: var(--sg-blue);

  background: #eff7ff;
}

.hero-field-content {
  min-width: 0;
}

.hero-field-content small,
.hero-field-content strong {
  display: block;

  font-family:
    var(--font-jakarta),
    "Plus Jakarta Sans",
    Arial,
    sans-serif;
}

.hero-field-content small {
  margin: 0 0 3px;

  color: #718198;

  font-size: 10px;
  line-height: 1.2;

  font-weight: 500;
}

.hero-field-content strong {
  overflow: hidden;

  color: #102f59;

  font-size: 12px;
  line-height: 1.25;

  font-weight: 700;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-counter {
  display: flex;
  align-items: center;

  gap: 6px;

  white-space: nowrap;
}

.hero-counter button {
  width: 22px;
  height: 22px;

  flex: 0 0 22px;

  padding: 0;
}

.hero-search-button {
  min-width: 0;
  height: 58px;

  border: 0;
  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  background: var(--sg-blue);

  color: #ffffff;

  font-family:
    var(--font-jakarta),
    "Plus Jakarta Sans",
    Arial,
    sans-serif;

  font-size: 13px;
  line-height: 1;

  font-weight: 700;

  white-space: nowrap;

  box-shadow:
    0 7px 18px rgba(8, 120, 249, .20);
}

.hero-search-button:hover {
  background: #0068df;
}


/* ============================================================
   BENEFIT
   Hanya spacing + typography.
   Tidak mengubah section setelahnya.
   ============================================================ */

.ref-benefit {
  width: 100%;

  margin: 0;

  /*
   * Controls keluar 74px dari hero.
   * Tinggi controls kira-kira 118px.
   * Jadi reserve ruang secukupnya saja.
   */
  padding:
    124px
    0
    12px;

  background: #ffffff;
}

.ref-benefit-grid {
  width: min(
    var(--sg-top-shell),
    calc(100% - var(--sg-top-gutter))
  );

  margin-inline: auto;

  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  /*
   * User meminta jangan pakai bingkai luar.
   */
  overflow: visible;

  border: 0;
  border-radius: 0;

  background: transparent;

  box-shadow: none;
}

.ref-benefit-grid article {
  min-width: 0;
  min-height: 62px;

  padding: 9px 15px;

  display: flex;
  align-items: center;

  gap: 10px;

  border: 0;
  border-right: 1px solid #e4ebf3;

  background: transparent;
}

.ref-benefit-grid article:last-child {
  border-right: 0;
}

.ref-round-icon {
  width: 36px;
  height: 36px;

  flex: 0 0 36px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: var(--sg-blue);

  background: #edf6ff;
}

.ref-benefit-grid strong {
  display: block;

  color: #17365e;

  font-family:
    var(--font-jakarta),
    "Plus Jakarta Sans",
    Arial,
    sans-serif;

  font-size: 12px;
  line-height: 1.25;

  font-weight: 700;
}

.ref-benefit-grid p {
  margin: 3px 0 0;

  color: #74859b;

  font-family:
    var(--font-jakarta),
    "Plus Jakarta Sans",
    Arial,
    sans-serif;

  font-size: 10px;
  line-height: 1.35;

  font-weight: 400;
}


/* ============================================================
   DESKTOP MEDIUM
   ============================================================ */

@media (max-width: 1180px) and (min-width: 901px) {

  :root {
    --sg-top-gutter: 24px;
  }

  .hero-reference {
    min-height: 500px;
  }

  .hero-reference-shell {
    min-height: 500px;
  }

  .hero-reference-copy h1 {
    font-size: clamp(37px, 4vw, 48px);
  }

  .hero-search-card {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr)
      minmax(145px, .72fr)
      minmax(160px, .82fr)
      100px;

    gap: 8px;
  }

  .hero-tabs button {
    padding-inline: 10px;

    font-size: 11px;
  }
}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 900px) and (min-width: 701px) {

  :root {
    --sg-top-gutter: 20px;
  }

  .hero-reference {
    min-height: 520px;
  }

  .hero-reference-shell {
    min-height: 520px;
  }

  .hero-controls {
    bottom: -150px;
  }

  .hero-tabs {
    max-width: 100%;
  }

  .hero-tabs button {
    height: 40px;

    padding-inline: 9px;

    font-size: 10px;
  }

  .hero-search-card {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .hero-search-button {
    grid-column: 1 / -1;

    height: 50px;
  }

  .ref-benefit {
    padding-top: 205px;
  }
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 700px) {

  :root {
    --sg-top-gutter: 16px;
  }

  .hero-reference {
    min-height: 690px;

    background: #edf8ff;
  }

  /*
   * Hero image tetap real image.
   */
  .hero-reference-media,
  .hero-reference-overlay {
    height: 240px;

    bottom: auto;
  }

  .hero-reference-photo {
    object-fit: cover !important;
    object-position: center center !important;
  }

  .hero-reference-shell {
    width: 100%;
    min-height: 690px;

    padding-top: 18px;
  }

  .hero-reference-copy {
    width: min(330px, calc(100% - 28px));
  }

  .hero-reference-copy h1 {
    font-size: 29px;
    line-height: 1.03;

    letter-spacing: -1px;
  }

  .hero-reference-copy p {
    max-width: 305px;

    margin-top: 7px;

    font-size: 10px;
    line-height: 1.45;
  }

  .hero-controls {
    bottom: 12px;

    width: calc(100% - 16px);

    gap: 6px;
  }

  .hero-tabs {
    width: 100%;
    max-width: 100%;

    margin: 0;

    padding: 6px;

    justify-content: flex-start;

    border-radius: 16px;
  }

  .hero-tabs button {
    min-width: 72px;
    height: 51px;

    padding: 4px 6px;

    flex-direction: column;

    gap: 3px;

    border-radius: 11px;

    font-size: 10px;
  }

  .hero-tab-icon {
    width: 25px;
    height: 25px;

    flex-basis: 25px;
  }

  .hero-search-card {
    grid-template-columns: 1fr;

    padding: 9px;

    gap: 7px;

    border-radius: 16px;
  }

  .hero-field {
    height: 54px;
  }

  .hero-field-content small {
    font-size: 10px;
  }

  .hero-field-content strong {
    font-size: 12px;
  }

  .hero-search-button {
    width: 100%;
    height: 48px;

    font-size: 12px;
  }

  .ref-benefit {
    padding:
      14px
      0
      8px;
  }

  .ref-benefit-grid {
    width: calc(100% - 16px);

    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .ref-benefit-grid article {
    min-height: 72px;

    padding: 7px 3px;

    display: block;

    text-align: center;
  }

  .ref-round-icon {
    width: 30px;
    height: 30px;

    margin: 0 auto 5px;
  }

  .ref-benefit-grid strong {
    font-size: 10px;
  }

  .ref-benefit-grid p {
    display: none;
  }
}


/* SEGALOKA HERO FLOW FINAL START */

/* ============================================================
   HERO FLOW FINAL
   Controls absolute, tetapi hero menyediakan reserve space.
   Benefit kembali ke normal document flow.
   ============================================================ */

.hero-reference {
  position: relative !important;

  margin-bottom: 0 !important;

  /*
   * Hero visual tetap 520px.
   * Tambahan 104px adalah ruang untuk floating tabs + search.
   */
  min-height: 624px !important;

  overflow: visible !important;
}

.hero-reference-media,
.hero-reference-overlay {
  height: 520px !important;
}

.hero-reference-shell {
  min-height: 520px !important;
}


/* ============================================================
   FLOATING CONTROLS
   ============================================================ */

.hero-controls {
  position: absolute !important;

  left: 50% !important;
  right: auto !important;

  /*
   * Search turun keluar hero visual tetapi masih berada
   * di dalam reserve space hero-reference.
   */
  bottom: 18px !important;
  top: auto !important;

  transform: translateX(-50%) !important;

  width: min(
    var(--sg-top-shell, 1180px),
    calc(100% - var(--sg-top-gutter, 32px))
  ) !important;

  max-width: none !important;

  margin: 0 !important;
  padding: 0 !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;

  gap: 6px !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  z-index: 50 !important;
}


/* ============================================================
   CATEGORY PILL
   ============================================================ */

.hero-tabs {
  position: relative !important;

  left: auto !important;
  right: auto !important;
  top: auto !important;
  bottom: auto !important;

  transform: none !important;

  align-self: center !important;

  width: max-content !important;
  max-width: 100% !important;

  margin: 0 auto !important;

  z-index: 52 !important;
}


/* ============================================================
   SEARCH
   ============================================================ */

.hero-search-card {
  position: relative !important;

  left: auto !important;
  right: auto !important;
  top: auto !important;
  bottom: auto !important;

  transform: none !important;

  width: 100% !important;

  margin: 0 !important;

  z-index: 51 !important;
}


