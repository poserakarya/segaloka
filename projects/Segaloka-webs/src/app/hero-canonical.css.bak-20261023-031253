  .detail-ref-shell {
    width: calc(100% - 20px);
  }

  .detail-ref-gallery {
    height: auto;
    grid-template-columns: repeat(2,1fr);
    grid-template-rows: 230px 92px 92px;
    gap: 7px;
  }

  .detail-ref-main-photo {
    grid-column: 1 / 3;
    grid-row: 1;
  }

  .detail-ref-summary {
    padding: 16px;
  }

  .detail-ref-summary h1 {
    font-size: 21px;
  }

  .detail-ref-facts {
    grid-template-columns: repeat(2,1fr);
  }

  .detail-ref-tabs {
    margin-left: -2px;
    margin-right: -2px;
  }

  .detail-ref-hotel-grid,
  .detail-ref-inc-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .detail-ref-travel {
    flex-wrap: wrap;
  }

  .detail-ref-travel-copy {
    min-width: calc(100% - 76px);
  }

  .detail-ref-outline-button,
  .detail-ref-message-button {
    flex: 1;
  }

  .detail-ref-room > div {
    grid-template-columns: repeat(3,1fr);
  }

  .package-detail-ad {
    min-height: 126px;
    padding: 15px 90px 15px 15px;
  }

  .package-detail-ad-copy h2 {
    font-size: 14px;
  }

  .package-detail-ad-action {
    right: 10px;
    top: 10px;
    bottom: 10px;
    flex-direction: column;
    justify-content: space-between;
  }

  .package-detail-ad-badge {
    width: 58px;
    height: 58px;
  }

  .package-detail-ad-button {
    min-height: 27px;
    padding: 0 7px;
    font-size: 7px;
  }

  .detail-ref-recommendation-grid {
    grid-template-columns: 1fr;
  }

  .detail-ref-package-card {
    display: grid;
    grid-template-columns: 115px 1fr;
  }

  .detail-ref-package-photo {
    height: 100%;
    min-height: 125px;
  }
}

