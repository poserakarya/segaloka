import { NextRequest, NextResponse } from "next/server";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

type LoginResult = {
  authenticated?: boolean;
  message?: string;
  session?: {
    accessToken?: string;
    refreshToken?: string;
  };
};

export async function POST(request: NextRequest) {
  let body: unknown;

  try {
    body = await request.json();
  } catch {
    return NextResponse.json(
      { authenticated: false, message: "Format permintaan tidak valid." },
      { status: 400 },
    );
  }

  if (
    !body ||
    typeof body !== "object" ||
    Array.isArray(body)
  ) {
    return NextResponse.json(
      { authenticated: false, message: "Data login tidak valid." },
      { status: 400 },
    );
  }

  const credentials = body as Record<string, unknown>;

  const email =
    typeof credentials.email === "string"
      ? credentials.email.trim()
      : "";

  const password =
    typeof credentials.password === "string"
      ? credentials.password
      : "";

  if (!email || !password || password.length > 128) {
    return NextResponse.json(
      { authenticated: false, message: "Email atau password tidak valid." },
      { status: 400 },
    );
  }

  const baseUrl = process.env.SEGALOKA_API_BASE_URL;
  const originSecret = process.env.SEGALOKA_ORIGIN_AUTH_SECRET;

  if (!baseUrl || !originSecret || originSecret.length < 32) {
    return NextResponse.json(
      { authenticated: false, message: "Layanan login belum tersedia." },
      { status: 503 },
    );
  }

  try {
    const url = new URL("/auth/login", baseUrl);

    const response = await fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "x-segaloka-origin-auth": originSecret,
      },
      body: JSON.stringify({ email, password }),
      cache: "no-store",
      redirect: "manual",
      signal: AbortSignal.timeout(10000),
    });

    if (response.status === 429) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Terlalu banyak percobaan login. Coba lagi nanti.",
        },
        { status: 429 },
      );
    }

    if (response.status === 401) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Email atau password tidak valid.",
        },
        { status: 401 },
      );
    }

    if (!response.ok) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Layanan login sedang mengalami gangguan.",
        },
        { status: 502 },
      );
    }

    const result = (await response.json()) as LoginResult;

    const accessToken = result.session?.accessToken;
    const refreshToken = result.session?.refreshToken;

    if (
      result.authenticated !== true ||
      !accessToken ||
      !refreshToken
    ) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Sesi login tidak valid.",
        },
        { status: 502 },
      );
    }

    const accessResponse = await fetch(
      new URL("/dashboard/access", baseUrl),
      {
        headers: {
          Authorization: `Bearer ${accessToken}`,
          "x-segaloka-origin-auth": originSecret,
        },
        cache: "no-store",
        redirect: "manual",
        signal: AbortSignal.timeout(10000),
      },
    );

    if (!accessResponse.ok) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Hak akses akun belum dapat diverifikasi.",
        },
        { status: 502 },
      );
    }

    const access = await accessResponse.json() as {
      authenticated?: boolean;
      dashboards?: Array<{
        dashboard: string;
        role: string;
        organizationId?: string | null;
      }>;
    };

    if (
      access.authenticated !== true ||
      !Array.isArray(access.dashboards)
    ) {
      return NextResponse.json(
        {
          authenticated: false,
          message: "Hak akses akun tidak valid.",
        },
        { status: 403 },
      );
    }

    const resultResponse = NextResponse.json({
      authenticated: true,
      dashboards: access.dashboards,
    });

    const secure = process.env.NODE_ENV === "production";

    resultResponse.cookies.set(
      "segaloka_access",
      accessToken,
      {
        httpOnly: true,
        secure,
        sameSite: "lax",
        path: "/",
        maxAge: 900,
      },
    );

    resultResponse.cookies.set(
      "segaloka_refresh",
      refreshToken,
      {
        httpOnly: true,
        secure,
        sameSite: "lax",
        path: "/api/auth",
      },
    );

    return resultResponse;
  } catch (error) {
    console.error("[Segaloka Website Login]", error);

    return NextResponse.json(
      {
        authenticated: false,
        message: "Tidak dapat menghubungi layanan login.",
      },
      { status: 503 },
    );
  }
}