  font-weight: 750;
}

.partner-travel-page .partner-audience-body p {
  margin: 0;
  color: var(--pt-body);
  font-size: 9.5px;
  line-height: 1.55;
}

/* ==========================================================
   4. FOUR STEPS
   ========================================================== */

.partner-travel-page .partner-steps {
  position: relative;
  gap: 15px;
}

.partner-travel-page .partner-step {
  --step-accent: #087cf0;
  --step-soft: #e9f4ff;

  position: relative;
  min-height: 162px;

  padding: 21px 17px 18px;

  border: 1px solid var(--pt-border);
  border-radius: 16px;

  background: #fff;

  box-shadow:
    0 7px 22px rgba(26, 64, 103, .05);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.partner-travel-page .partner-step:nth-of-type(2) {
  --step-accent: #087cf0;
  --step-soft: #e9f4ff;
}

.partner-travel-page .partner-step:nth-of-type(3) {
  --step-accent: #10a97c;
  --step-soft: #e7f8f2;
}

.partner-travel-page .partner-step:nth-of-type(4) {
  --step-accent: #8845df;
  --step-soft: #f2eaff;
}

.partner-travel-page .partner-step:nth-of-type(5) {
  --step-accent: #ef8422;
  --step-soft: #fff1e4;
}

.partner-travel-page .partner-step:hover {
  transform: translateY(-3px);
  box-shadow:
    0 15px 34px rgba(26, 64, 103, .10);
}

.partner-travel-page .partner-step-number {
  position: absolute;
  top: 14px;
  right: 14px;

  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 999px;

  background: var(--step-accent);
  color: #fff;

  font-size: 10px;
  font-weight: 800;

  box-shadow:
    0 5px 12px
    color-mix(
      in srgb,
      var(--step-accent) 22%,
      transparent
    );
}

.partner-travel-page .partner-step-icon {
  width: 45px;
  height: 45px;

  display: grid;
  place-items: center;

  margin-bottom: 15px;

  border-radius: 13px;

  background: var(--step-soft);
  color: var(--step-accent);
}

.partner-travel-page .partner-step-icon svg {
  stroke-width: 2.15;
}

.partner-travel-page .partner-step h3 {
  margin: 0 0 6px;
  font-size: 12px;
  font-weight: 750;
}

.partner-travel-page .partner-step p {
  margin: 0;
  color: var(--pt-body);
  font-size: 9.5px;
  line-height: 1.6;
}

/* ==========================================================
   5. START FREE CTA
   ========================================================== */

.partner-travel-page .partner-registration-cta {
  position: relative;

  margin-top: 20px;
  padding: 18px 20px;

  overflow: hidden;

  border: 1px solid #d7e9fb;
  border-radius: 17px;

  background:
    radial-gradient(
      circle at 88% 20%,
      rgba(8,124,240,.10),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #f8fcff,
      #edf7ff
    );

  box-shadow:
    0 9px 28px rgba(21, 86, 145, .07);
}

.partner-travel-page .partner-registration-cta::after {
  content: "";
  position: absolute;
  right: -34px;
  bottom: -55px;

  width: 145px;
  height: 145px;

  border: 25px solid rgba(8,124,240,.045);
  border-radius: 50%;

  pointer-events: none;
}

.partner-travel-page .partner-registration-cta > * {
  position: relative;
  z-index: 2;
}

.partner-travel-page .partner-registration-cta > div > span {
  display: inline-block;
  margin-bottom: 5px;

  color: var(--pt-blue);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.partner-travel-page .partner-registration-cta h3 {
  margin: 0 0 5px;
  font-size: 14px;
  font-weight: 800;
}

.partner-travel-page .partner-registration-cta p {
  margin: 0;
  max-width: 620px;

  color: var(--pt-body);
  font-size: 9.5px;
  line-height: 1.55;
}

.partner-travel-page .partner-registration-cta
.partner-primary-button {
  min-width: 148px;
  min-height: 40px;

  border-radius: 10px;

  box-shadow:
    0 8px 18px rgba(8,124,240,.19);
}

/* ==========================================================
   6. PRICING — PREMIUM, TIDAK KAKU
   ========================================================== */

.partner-travel-page .partner-pricing-grid {
  align-items: stretch;
  gap: 16px;
}

.partner-travel-page .partner-pricing-card {
  position: relative;

  min-height: 100%;
  padding: 21px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border: 1px solid #dfe9f3;
  border-radius: 18px;

  background: #fff;

  box-shadow:
    0 9px 27px rgba(23, 62, 100, .06);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.partner-travel-page .partner-pricing-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 19px 42px rgba(23, 62, 100, .12);
}

.partner-travel-page .partner-pricing-card.is-popular {
  border: 1.5px solid #1687f5;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(8,124,240,.10),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      #fafdff,
      #ffffff 40%
    );

  box-shadow:
    0 16px 42px rgba(8,124,240,.13);

  transform: translateY(-5px);
}

.partner-travel-page .partner-pricing-card.is-popular:hover {
  transform: translateY(-8px);
}

.partner-travel-page .partner-pricing-popular {
  position: absolute;
  top: 14px;
  right: 14px;

  padding: 6px 10px;

  border-radius: 999px;

  background: #087cf0;
  color: #fff;

  font-size: 8px;
  font-weight: 800;
  line-height: 1;

  box-shadow:
    0 6px 14px rgba(8,124,240,.18);
}

.partner-travel-page .partner-pricing-heading {
  display: flex;
  align-items: center;
  gap: 12px;

  padding-right: 82px;
}

.partner-travel-page .partner-pricing-heading > svg {
  width: 43px;
  height: 43px;
  padding: 10px;

  flex: 0 0 43px;

  border-radius: 12px;

  background: #edf6ff;
  color: #087cf0;
}

.partner-travel-page
.partner-pricing-card:nth-child(1)
.partner-pricing-heading > svg {
  background: #eef5ff;
  color: #3269db;
}

.partner-travel-page
.partner-pricing-card:nth-child(2)
.partner-pricing-heading > svg {
  background: #e8f4ff;
  color: #087cf0;
}

.partner-travel-page
.partner-pricing-card:nth-child(3)
.partner-pricing-heading > svg {
  background: #f1ebff;
  color: #8245da;
}

.partner-travel-page .partner-pricing-heading h3 {
  margin: 0 0 3px;
  font-size: 14px;
  font-weight: 800;
}

.partner-travel-page .partner-pricing-heading p {
  margin: 0;

  color: var(--pt-body);
  font-size: 9px;
  line-height: 1.45;
}

.partner-travel-page .partner-pricing-price {
  margin: 19px 0 15px;
  padding-bottom: 15px;

  display: flex;
  align-items: flex-end;
  gap: 5px;

  border-bottom: 1px solid #e8eef5;
}

.partner-travel-page .partner-pricing-price strong {
  color: #102f52;
  font-size: 23px;
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1;
}

.partner-travel-page .partner-pricing-price span {
  padding-bottom: 2px;

  color: #8394a7;
  font-size: 8.5px;
}

.partner-travel-page .partner-growth-highlights {
  margin: -2px 0 14px;

  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.partner-travel-page .partner-growth-highlights span {
  min-height: 27px;
  padding: 5px 8px;

  display: inline-flex;
  align-items: center;
  gap: 4px;

  border: 1px solid #d5e9fc;
  border-radius: 8px;

  background: #eef7ff;
  color: #126cc5;

  font-size: 8px;
  font-weight: 750;
}

.partner-travel-page .partner-pricing-card ul {
  margin: 0 0 20px;
  padding: 0;

  display: grid;
  gap: 9px;

  list-style: none;
}

.partner-travel-page .partner-pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 8px;

  color: #536b83;
  font-size: 9px;
  line-height: 1.45;
}

.partner-travel-page .partner-pricing-card li svg {
  width: 17px;
  height: 17px;
  padding: 3px;

  flex: 0 0 17px;

  border-radius: 50%;

  background: #e9f7f0;
  color: #139965;

  stroke-width: 3;
}

.partner-travel-page .partner-pricing-button {
  width: 100%;
  min-height: 38px;

  margin-top: auto;

  border: 1px solid #cbd9e8;
  border-radius: 10px;

  background: #fff;
  color: #173a5e;

  font-size: 9.5px;
  font-weight: 800;

  cursor: pointer;

  transition:
    transform .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

.partner-travel-page .partner-pricing-button:hover {
  transform: translateY(-1px);
  background: #f6faff;
}

.partner-travel-page .partner-pricing-button.primary {
  border-color: #087cf0;

  background:
    linear-gradient(
      135deg,
      #087cf0,
      #0569d6
    );

  color: #fff;

  box-shadow:
    0 8px 18px rgba(8,124,240,.20);
}

.partner-travel-page .partner-subscription-benefit {
  margin-top: 16px;
  padding: 13px 16px;

  border: 1px solid #dce9f5;
  border-radius: 13px;

  background: #f8fbfe;
}

/* ==========================================================
   7. RTL
   ========================================================== */

html[dir="rtl"]
.partner-travel-page
.partner-feature-card {
  padding-right: 18px;
  padding-left: 42px;
}

html[dir="rtl"]
.partner-travel-page
.partner-feature-card
.partner-card-arrow {
  right: auto;
  left: 16px;
  transform: rotate(180deg);
}

html[dir="rtl"]
.partner-travel-page
.partner-feature-card:hover
.partner-card-arrow {
  transform: rotate(180deg) translateX(3px);
}

html[dir="rtl"]
.partner-travel-page
.partner-step-number {
  right: auto;
  left: 14px;
}

html[dir="rtl"]
.partner-travel-page
.partner-pricing-popular {
  right: auto;
  left: 14px;
}

html[dir="rtl"]
.partner-travel-page
.partner-pricing-heading {
  padding-right: 0;
  padding-left: 82px;
}

/* ==========================================================
   8. RESPONSIVE
   ========================================================== */

@media (max-width: 900px) {
  .partner-travel-page .partner-pricing-card.is-popular {
    transform: none;
  }

  .partner-travel-page .partner-pricing-card.is-popular:hover {
    transform: translateY(-4px);
  }
}

@media (max-width: 720px) {
  .partner-travel-page .partner-feature-card {
    min-height: 112px;
  }

  .partner-travel-page .partner-audience-visual {
    height: 100px;
  }

  .partner-travel-page .partner-registration-cta {
    padding: 17px;
  }

  .partner-travel-page .partner-pricing-card {
    padding: 18px;
  }

  .partner-travel-page .partner-pricing-heading {
    padding-right: 74px;
  }

  html[dir="rtl"]
  .partner-travel-page
  .partner-pricing-heading {
    padding-right: 0;
    padding-left: 74px;
  }
}
/* SEGALOKA PARTNER TRAVEL V8 — TYPOGRAPHY LOCK */

/*
  CANONICAL TYPE SCALE
  Hero H1       : 42px desktop
  Section H2    : 24px
  Card H3       : 14px
  Body          : 12px
  Helper        : 11px
  Small/meta    : 10px
  Pricing       : 25px

  Semua komponen Partner Travel wajib mengikuti scale ini.
*/

.partner-travel-page {
  --pt-font:
    "Plus Jakarta Sans",
    "Jakarta Sans",
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  --pt-text-hero: 42px;
  --pt-text-section: 24px;
  --pt-text-card: 14px;
  --pt-text-body: 12px;
  --pt-text-helper: 11px;
  --pt-text-small: 10px;
  --pt-text-price: 25px;

  --pt-leading-hero: 1.08;
  --pt-leading-heading: 1.25;
  --pt-leading-body: 1.55;

  font-family: var(--pt-font);
}

/* =========================================================
   GLOBAL RESET DALAM PARTNER PAGE
   ========================================================= */

.partner-travel-page h1,
.partner-travel-page h2,
.partner-travel-page h3,
.partner-travel-page h4,
.partner-travel-page p,
.partner-travel-page a,
.partner-travel-page button,
.partner-travel-page span,
.partner-travel-page li,
.partner-travel-page small {
  font-family: var(--pt-font);
}

/* =========================================================
   HERO
   ========================================================= */

.partner-travel-page .partner-kicker {
  font-size: var(--pt-text-helper);
  font-weight: 700;
  line-height: 1.4;
}

.partner-travel-page .partner-hero-copy h1 {
  max-width: 620px;

  margin-top: 12px;
  margin-bottom: 16px;

  font-size: var(--pt-text-hero) !important;
  font-weight: 750;
  line-height: var(--pt-leading-hero);
  letter-spacing: -0.045em;
}

.partner-travel-page .partner-hero-copy h1 strong {
  font-size: inherit;
  font-weight: 800;
}

.partner-travel-page .partner-hero-copy > p {
  max-width: 610px;

  font-size: var(--pt-text-body) !important;
  font-weight: 400;
  line-height: 1.65;
}

/* Hero benefit */

.partner-travel-page .partner-hero-benefits strong {
