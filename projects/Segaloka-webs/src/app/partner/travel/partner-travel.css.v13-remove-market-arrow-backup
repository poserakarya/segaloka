.partner-travel-page {
  background: #fff;
  color: #0b2343;
  overflow-x: clip;
}

.partner-shell {
  width: min(1180px, calc(100% - 40px));
  margin-inline: auto;
}

.partner-local-nav {
  position: sticky;
  top: var(--header-height, 0px);
  z-index: 25;
  border-bottom: 1px solid #edf1f6;
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(14px);
}

.partner-local-nav-inner {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.partner-local-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 34px;
}

.partner-local-links button {
  padding: 7px 0;
  border: 0;
  background: transparent;
  color: #1a3555;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.partner-local-links button:hover {
  color: #0877f9;
}

.partner-hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 69% 36%, rgba(46,153,255,.13), transparent 28%),
    linear-gradient(115deg,#fff 0%,#fff 44%,#f0f8ff 70%,#e7f5ff 100%);
}

.partner-hero-grid {
  min-height: 520px;
  display: grid;
  grid-template-columns: minmax(0, .88fr) minmax(480px, 1.12fr);
  align-items: center;
  gap: 42px;
}

.partner-hero-copy {
  position: relative;
  z-index: 4;
  padding-block: 42px;
}

.partner-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 14px;
  color: #0877f9;
  font-size: 12px;
  font-weight: 800;
}

.partner-hero-copy h1 {
  max-width: 580px;
  margin: 0;
  color: #0b203d;
  font-size: clamp(39px, 4vw, 55px);
  font-weight: 800;
  line-height: 1.06;
  letter-spacing: -.045em;
}

.partner-hero-copy h1 strong {
  color: #0877f9;
}

.partner-hero-copy > p {
  max-width: 560px;
  margin: 18px 0 0;
  color: #536b86;
  font-size: 14px;
  line-height: 1.65;
}

.partner-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}

.partner-primary-button,
.partner-secondary-button {
  min-height: 44px;
  padding: 0 21px;
  border-radius: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.partner-primary-button {
  border: 1px solid #0877f9;
  background: #0877f9;
  color: #fff;
  box-shadow: 0 9px 20px rgba(8,119,249,.18);
}

.partner-secondary-button {
  border: 1px solid #82b8f8;
  background: #fff;
  color: #0877f9;
}

.partner-hero-benefits {
  margin-top: 28px;
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 14px;
}

.partner-hero-benefits > div {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

.partner-benefit-icon {
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  border: 1px solid #a9d0fb;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #0877f9;
  background: #f8fcff;
}

.partner-hero-benefits > div > span:last-child {
  display: flex;
  flex-direction: column;
  color: #6b7e94;
  font-size: 9px;
  line-height: 1.35;
}

.partner-hero-benefits strong {
  color: #17385f;
  font-size: 10px;
}

.partner-hero-visual {
  position: relative;
  align-self: stretch;
  min-height: 520px;
  margin-inline-end: calc((100vw - min(1180px, calc(100vw - 40px))) / -2);
  overflow: hidden;
}

.partner-map-dots {
  position: absolute;
  z-index: 0;
  inset: 32px 0 70px 4%;
  opacity: .52;
  background-image: radial-gradient(circle,#58aef8 1.6px,transparent 1.8px);
  background-size: 11px 11px;
  mask-image:
    radial-gradient(ellipse at 52% 45%,#000 0 43%,transparent 66%);
}

.partner-hero-photo {
  position: absolute;
  z-index: 1;
  right: -5%;
  bottom: -8%;
  width: 93%;
  height: 75%;
  object-fit: cover;
  object-position: center;
  border-radius: 52% 0 0 0;
  filter: saturate(.96) contrast(.98);
}

.partner-hero-fade {
  position: absolute;
  z-index: 2;
  inset: 0;
  background:
    linear-gradient(90deg,#f5fbff 0%,rgba(245,251,255,.72) 9%,transparent 31%),
    linear-gradient(0deg,rgba(240,249,255,.12),transparent 58%);
  pointer-events: none;
}

.partner-plane {
  position: absolute;
  z-index: 4;
  color: #577b9f;
  filter: drop-shadow(0 8px 8px rgba(34,75,115,.16));
  transform: rotate(-17deg);
}

.partner-plane-one {
  top: 88px;
  left: 38%;
}

.partner-plane-two {
  top: 210px;
  left: 23%;
}

.partner-map-pin {
  position: absolute;
  z-index: 4;
  width: 10px;
  height: 10px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #0877f9;
  box-shadow: 0 3px 9px rgba(8,119,249,.35);
}

.partner-pin-one {
  top: 170px;
  left: 25%;
}

.partner-pin-two {
  top: 274px;
  left: 16%;
}

.partner-pin-three {
  top: 110px;
  left: 58%;
}

.partner-country {
  position: absolute;
  z-index: 5;
  width: 41px;
  height: 41px;
  border: 4px solid rgba(255,255,255,.92);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #fff;
  font-size: 10px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(22,70,115,.18);
}

.partner-country-id {
  top: 62px;
  right: 28%;
  background: linear-gradient(#ef3e46 0 50%,#fff 50%);
  color: #17385f;
}

.partner-country-sa {
  top: 82px;
  right: 16%;
  background: #15944b;
}

.partner-country-my {
  top: 151px;
  right: 9%;
  background: #1758a6;
}

.partner-country-tr {
  top: 215px;
  right: 16%;
  background: #e8373d;
}

.partner-network-card,
.partner-floating-badge {
  position: absolute;
  z-index: 6;
  border: 1px solid rgba(255,255,255,.9);
  background: rgba(255,255,255,.93);
  box-shadow: 0 13px 30px rgba(20,70,120,.14);
  backdrop-filter: blur(9px);
}

.partner-network-card {
  left: 13%;
  bottom: 35px;
  padding: 10px 13px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.partner-network-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #e9f4ff;
  color: #0877f9;
}

.partner-network-card div {
  display: flex;
  flex-direction: column;
}

.partner-network-card small {
  color: #7a8ca0;
  font-size: 9px;
}

.partner-network-card strong {
  color: #16375e;
  font-size: 10px;
}

.partner-floating-badge {
  padding: 7px 10px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #0b65c5;
  font-size: 9px;
  font-weight: 800;
}

.partner-floating-badge-a {
  top: 273px;
  right: 8%;
}

.partner-floating-badge-b {
  top: 316px;
  right: 19%;
}

.partner-section {
  padding: 48px 0;
  scroll-margin-top: 110px;
}

.partner-section-soft {
  background: #fbfdff;
}

.partner-section-heading {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
}

.partner-section-marker {
  flex: 0 0 26px;
  width: 26px;
  height: 5px;
  margin-top: 10px;
  border-radius: 999px;
  background: #0877f9;
}

.partner-section-heading h2 {
  margin: 0;
  color: #0b2343;
  font-size: 22px;
  line-height: 1.2;
  letter-spacing: -.025em;
}

.partner-section-heading p {
  margin: 5px 0 0;
  color: #71849a;
  font-size: 11px;
  line-height: 1.55;
}

.partner-card-grid {
  display: grid;
  gap: 14px;
}

.partner-card-grid-four {
  grid-template-columns: repeat(4,minmax(0,1fr));
}

.partner-card-grid-three {
  grid-template-columns: repeat(3,minmax(0,1fr));
}

.partner-image-card,
.partner-feature-card,
.partner-audience-card {
  overflow: hidden;
  border: 1px solid #e3ebf4;
  border-radius: 9px;
  background: #fff;
  box-shadow: 0 5px 16px rgba(29,66,107,.06);
}

.partner-image-card-media {
  height: 108px;
  background: #edf5fc;
}

.partner-image-card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.partner-image-card-body,
.partner-feature-card,
.partner-audience-body {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.partner-image-card-body {
  min-height: 80px;
  padding: 13px;
}

.partner-card-icon {
  flex: 0 0 31px;
  width: 31px;
  height: 31px;
  border-radius: 7px;
  display: grid;
  place-items: center;
  color: #0877f9;
  background: #eaf5ff;
}

.partner-feature-icon {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: #0877f9;
}

.partner-image-card h3,
.partner-feature-card h3,
.partner-audience-card h3 {
  margin: 0;
  color: #102d50;
  font-size: 12px;
}

.partner-image-card p,
.partner-feature-card p,
.partner-audience-card p {
  margin: 4px 0 0;
  color: #71849a;
  font-size: 9px;
  line-height: 1.5;
}

.partner-card-arrow {
  flex: 0 0 auto;
  margin-inline-start: auto;
  color: #0877f9;
}

.partner-feature-card {
  min-height: 94px;
  padding: 16px;
}

.partner-audience-visual {
  height: 112px;
  display: grid;
  place-items: center;
  color: #0877f9;
  background:
    radial-gradient(circle at center,#fff,transparent 58%),
    linear-gradient(135deg,#e8f5ff,#f7fbff);
}

.partner-audience-body {
  min-height: 72px;
  padding: 14px;
}

.partner-steps {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 20px;
  margin-top: 29px;
}

.partner-step-line {
  position: absolute;
  top: 17px;
  inset-inline: 12.5%;
  border-top: 1px dashed #78b7fb;
}

.partner-step {
  position: relative;
  z-index: 1;
  text-align: center;
}

.partner-step-number {
  width: 35px;
  height: 35px;
  margin-inline: auto;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #0877f9;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 7px 15px rgba(8,119,249,.19);
}

.partner-step-icon {
  width: 38px;
  height: 38px;
  margin: 8px auto 7px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e9f4ff;
  color: #0877f9;
}

.partner-step h3 {
  margin: 0;
  color: #16375e;
  font-size: 11px;
}

.partner-step p {
  max-width: 185px;
  margin: 5px auto 0;
  color: #71849a;
  font-size: 9px;
  line-height: 1.5;
}

.partner-registration-cta {
  margin-top: 32px;
  padding: 20px 23px;
  border: 1px solid #dceafa;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  background: #fff;
}

.partner-registration-cta span {
  color: #0877f9;
  font-size: 9px;
  font-weight: 800;
}

.partner-registration-cta h3 {
  margin: 3px 0 0;
  color: #102d50;
  font-size: 16px;
}

.partner-registration-cta p {
  max-width: 650px;
  margin: 5px 0 0;
  color: #71849a;
  font-size: 10px;
}

.partner-faq-list {
  overflow: hidden;
  border: 1px solid #e1eaf4;
  border-radius: 8px;
  background: #fff;
}

.partner-faq + .partner-faq {
  border-top: 1px solid #e7eef6;
}

.partner-faq button {
  width: 100%;
  min-height: 38px;
  padding: 0 14px;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: #fff;
  color: #17385f;
  text-align: start;
  font: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.partner-faq button svg {
  flex: 0 0 auto;
  color: #0877f9;
  transition: transform 180ms ease;
}

.partner-faq.is-open button svg {
  transform: rotate(180deg);
}

.partner-faq-answer {
  padding: 0 14px 13px;
}

.partner-faq-answer p {
  max-width: 900px;
  margin: 0;
  color: #71849a;
  font-size: 10px;
  line-height: 1.65;
}

.partner-contact-section {
  padding: 47px 0 58px;
  background:
    radial-gradient(circle at 85% 60%,rgba(29,148,255,.08),transparent 25%),
    linear-gradient(135deg,#fff,#f7fbff);
}

.partner-contact-grid {
  min-height: 185px;
  display: grid;
  grid-template-columns: 1fr .72fr;
  align-items: center;
  gap: 38px;
}

.partner-contact-link {
  width: fit-content;
  min-height: 41px;
  padding: 0 14px;
  border: 1px solid #8ebdf5;
  border-radius: 7px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #0877f9;
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  background: #fff;
}

.partner-contact-visual {
  min-height: 160px;
  display: grid;
  place-items: center;
  background-image: radial-gradient(circle,#acd7fa 1.2px,transparent 1.3px);
  background-size: 10px 10px;
  mask-image: linear-gradient(90deg,transparent,#000 25%,#000);
}

.partner-contact-circle {
  width: 235px;
  height: 135px;
  border-radius: 70% 35% 55% 45%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 19px;
  color: #0877f9;
  background:
    radial-gradient(circle at 70% 28%,#fff,transparent 23%),
    linear-gradient(135deg,#dff2ff,#f8fcff);
  box-shadow: 0 15px 35px rgba(42,119,188,.09);
}

html[dir="rtl"] .partner-hero-photo {
  right: auto;
  left: -5%;
  border-radius: 0 52% 0 0;
}

html[dir="rtl"] .partner-plane {
  transform: scaleX(-1) rotate(-17deg);
}

html[dir="rtl"] .partner-primary-button svg,
html[dir="rtl"] .partner-card-arrow {
  transform: scaleX(-1);
}

@media (max-width: 980px) {
  .partner-local-links {
    gap: 20px;
  }

  .partner-hero-grid {
    min-height: auto;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .partner-hero-copy {
    padding: 42px 0 20px;
  }

  .partner-hero-visual {
    min-height: 390px;
    margin-inline-end: 0;
  }

  .partner-card-grid-four {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }

  .partner-card-grid-three {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .partner-shell {
    width: min(100% - 24px,1180px);
  }

  .partner-local-nav {
    overflow-x: auto;
  }

  .partner-local-nav-inner {
    justify-content: flex-start;
  }

  .partner-local-links {
    width: max-content;
    justify-content: flex-start;
    gap: 22px;
  }

  .partner-hero-copy {
    padding-top: 30px;
  }

  .partner-hero-copy h1 {
    font-size: 34px;
  }

  .partner-hero-copy > p {
    font-size: 13px;
  }

  .partner-hero-actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .partner-primary-button,
  .partner-secondary-button {
    width: 100%;
  }

  .partner-hero-benefits {
    grid-template-columns: 1fr;
  }

  .partner-hero-visual {
    min-height: 310px;
  }

  .partner-hero-photo {
    width: 108%;
    height: 78%;
  }

  .partner-country {
    width: 34px;
    height: 34px;
    font-size: 8px;
  }

  .partner-section {
    padding: 38px 0;
  }

  .partner-section-heading h2 {
    font-size: 20px;
  }

  .partner-card-grid-four {
    grid-template-columns: 1fr;
  }

  .partner-steps {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .partner-step-line {
    display: none;
  }

  .partner-registration-cta {
    align-items: stretch;
    flex-direction: column;
  }

  .partner-contact-grid {
    grid-template-columns: 1fr;
  }

  .partner-contact-visual {
    min-height: 130px;
  }
}
/* ==========================================================
   PARTNER TRAVEL V3 — REFERENCE TARGET
   ========================================================== */

.partner-travel-page .partner-shell {
  width: min(1120px, calc(100% - 36px));
}

.partner-travel-page .partner-section {
  padding-top: 34px;
  padding-bottom: 34px;
}

.partner-travel-page .partner-section-heading {
  margin-bottom: 16px;
}

.partner-travel-page .partner-section-heading h2 {
  font-size: 20px;
}

.partner-travel-page .partner-section-heading p {
  font-size: 10px;
}

.partner-travel-page .partner-image-card-media {
  height: 104px;
}

.partner-travel-page .partner-image-card-body {
  min-height: 74px;
}

.partner-travel-page .partner-feature-card {
  min-height: 84px;
}

.partner-travel-page .partner-audience-visual {
  height: 104px;
}

.partner-travel-page .partner-audience-body {
  min-height: 68px;
}

.partner-pricing-section {
  background: #fff;
}

.partner-pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: stretch;
}

.partner-pricing-card {
  position: relative;
  min-height: 350px;
  padding: 24px 24px 20px;
  border: 1px solid #dbe6f2;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  background: #fff;
  box-shadow: 0 6px 18px rgba(22, 62, 104, .055);
}

.partner-pricing-card.is-popular {
  border: 2px solid #0877f9;
  box-shadow: 0 10px 26px rgba(8, 119, 249, .11);
}

.partner-pricing-popular {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  min-width: 108px;
  padding: 5px 12px;
  border-radius: 999px;
  background: #0877f9;
  color: #fff;
  text-align: center;
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
}

html[dir="rtl"] .partner-pricing-popular {
  left: auto;
  right: 50%;
  transform: translateX(50%);
}

.partner-pricing-heading {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: #0877f9;
}

.partner-pricing-heading h3 {
  margin: 0;
  color: #102d50;
  font-size: 18px;
  line-height: 1.2;
}

.partner-pricing-heading p {
  margin: 4px 0 0;
  color: #71849a;
  font-size: 10px;
  line-height: 1.45;
}

.partner-pricing-price {
  margin-top: 20px;
  display: flex;
  align-items: baseline;
  gap: 7px;
}

.partner-pricing-price strong {
  color: #075ed2;
  font-size: 27px;
  line-height: 1;
  letter-spacing: -.03em;
}

.partner-pricing-price span {
  color: #71849a;
  font-size: 10px;
}

.partner-pricing-card ul {
  margin: 22px 0;
  padding: 0;
  display: grid;
  gap: 9px;
  list-style: none;
}

.partner-pricing-card li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  color: #344f6e;
  font-size: 10px;
  line-height: 1.4;
}

.partner-pricing-card li svg {
  flex: 0 0 auto;
  margin-top: 1px;
  color: #0877f9;
  stroke-width: 3;
}

.partner-pricing-button {
  width: 100%;
  min-height: 39px;
  margin-top: auto;
  border: 1px solid #0877f9;
  border-radius: 6px;
  background: #fff;
  color: #0877f9;
  font: inherit;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
}

.partner-pricing-button.primary {
  background: #0877f9;
  color: #fff;
  box-shadow: 0 7px 16px rgba(8, 119, 249, .16);
