function detectPackageType(
  slug: string,
): PackageType {

  const value =
    slug.toLowerCase();

  if (value.includes("umrah")) {
    return "umrah";
  }

  if (value.includes("haji")) {
    return "haji";
  }

  if (
    value.includes("halal-tour") ||
    value.includes("halal")
  ) {
    return "halal-tour";
  }

  if (
    value.includes("domestic") ||
    value.includes("domestik")
  ) {
    return "tour-domestic";
  }

  if (
    value.includes("international") ||
    value.includes("internasional")
  ) {
    return "tour-international";
  }

  if (value.includes("segadeal")) {
    return "segadeals";
  }

  return "tour-international";
}


function titleFromSlug(
  slug: string,
) {
  return slug
    .split("-")
    .filter(Boolean)
    .map(
      (part) =>
        part.charAt(0).toUpperCase() +
        part.slice(1),
    )
    .join(" ");
}

function formatRupiah(
  value: number,
) {
  return new Intl.NumberFormat(
    "id-ID",
    {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    },
  ).format(value);
}


type CounterProps = {
  label: string;
  description: string;
  value: number;
  minimum?: number;
  onChange: (value: number) => void;
};


function Counter({
  label,
  description,
  value,
  minimum = 0,
  onChange,
}: CounterProps) {

  return (
    <div className={styles.counterRow}>

      <div>
        <strong>{label}</strong>
        <span>{description}</span>
      </div>

      <div className={styles.counter}>

        <button
          type="button"
          disabled={value <= minimum}
          onClick={() =>
            onChange(
              Math.max(
                minimum,
                value - 1,
              ),
            )
          }
        >
          <Minus size={14} />
        </button>

        <strong>
          {value}
        </strong>

        <button
          type="button"
          onClick={() =>
            onChange(value + 1)
          }
        >
          <Plus size={14} />
        </button>

      </div>

    </div>
  );
}


type OptionCardProps = {
