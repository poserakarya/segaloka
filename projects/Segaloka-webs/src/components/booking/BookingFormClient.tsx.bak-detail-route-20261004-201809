                        data identitas belum
                        dikirim ke backend.
                        Penyimpanan aman akan
                        dibuat saat integrasi
                        sistem.
                      </p>
                    </div>

                  </article>
                )}


                {vaccineHelp && (
                  <article
                    className={
                      styles.notice
                    }
                  >
                    <HeartPulse size={18} />

                    <div>
                      <strong>
                        Permintaan rekomendasi
                        vaksin dicatat
                      </strong>

                      <p>
                        Jenis vaksin, jadwal,
                        kelayakan, dan persyaratan
                        mengikuti ketentuan
                        destinasi serta penyedia
                        layanan kesehatan.
                      </p>
                    </div>
                  </article>
                )}


                {leaveLetter && (
                  <article
                    className={
                      styles.card
                    }
                  >

                    <div
                      className={
                        styles.cardHeading
                      }
                    >
                      <BriefcaseBusiness
                        size={20}
                      />

                      <div>
                        <h2>
                          Data Surat Cuti
                        </h2>

                        <p>
                          Isi informasi dasar
                          untuk kebutuhan surat.
                        </p>
                      </div>
                    </div>


                    <div
                      className={
                        styles.formGrid
                      }
                    >

                      <label>
                        <span>
                          Nama perusahaan
                        </span>

                        <input
                          value={
                            leaveForm.companyName
                          }
                          onChange={(event) =>
                            setLeaveForm({
                              ...leaveForm,
                              companyName:
                                event.target.value,
                            })
                          }
                        />
                      </label>


                      <label>
                        <span>
                          Jabatan
                        </span>

                        <input
                          value={
                            leaveForm.position
                          }
                          onChange={(event) =>
                            setLeaveForm({
                              ...leaveForm,
                              position:
                                event.target.value,
                            })
                          }
                        />
                      </label>


                      <label>
                        <span>
                          Mulai cuti
                        </span>

                        <input
                          type="date"
                          value={
                            leaveForm.leaveStart
                          }
                          onChange={(event) =>
                            setLeaveForm({
                              ...leaveForm,
                              leaveStart:
                                event.target.value,
                            })
                          }
                        />
                      </label>


                      <label>
                        <span>
                          Selesai cuti
                        </span>

                        <input
                          type="date"
                          value={
                            leaveForm.leaveEnd
                          }
                          onChange={(event) =>
                            setLeaveForm({
                              ...leaveForm,
                              leaveEnd:
                                event.target.value,
                            })
                          }
                        />
                      </label>

                    </div>

                  </article>
                )}
              </>
            )}


            {step === 4 && (
              <>
                <article
                  className={
                    styles.card
                  }
                >

                  <div
                    className={
                      styles.cardHeading
                    }
                  >
                    <CircleCheck size={20} />

                    <div>
                      <h2>
                        Review Pemesanan
                      </h2>

                      <p>
                        Periksa data sebelum
                        melanjutkan ke tahap
                        pembayaran.
                      </p>
                    </div>
                  </div>


                  <div
                    className={
                      styles.reviewList
                    }
                  >

                    <div>
                      <span>
                        Pemesan
                      </span>

                      <strong>
                        {purchaser.fullName ||
                          "-"}
                      </strong>
                    </div>

                    <div>
                      <span>
                        Kontak
                      </span>

                      <strong>
                        {purchaser.phone ||
                          "-"}
                      </strong>
                    </div>

                    <div>
                      <span>
                        Jumlah traveler
                      </span>

                      <strong>
                        {travelerTotal} orang
                      </strong>
                    </div>

                    <div>
                      <span>
                        Data traveler
                      </span>

                      <strong>
                        {travelerMode ===
                        "same"
                          ? "Pemesan sebagai traveler utama"
                          : travelerMode ===
                            "now"
                            ? "Diisi sekarang"
                            : "Dilengkapi kemudian"}
                      </strong>
                    </div>

                  </div>

                </article>


                <article
                  className={
                    styles.card
                  }
                >
                  <h2>
                    Layanan tambahan
                  </h2>

                  <div
                    className={
                      styles.checkList
                    }
                  >

                    {passportHelp && (
                      <span>
                        <Check size={14} />
                        Rekomendasi paspor
                      </span>
                    )}

                    {vaccineHelp && (
                      <span>
                        <Check size={14} />
                        Rekomendasi vaksin
                      </span>
                    )}

                    {leaveLetter && (
                      <span>
                        <Check size={14} />
                        Surat cuti
                      </span>
                    )}

                    {!passportHelp &&
                      !vaccineHelp &&
                      !leaveLetter && (
                        <small>
                          Tidak ada layanan
                          tambahan.
                        </small>
                      )}

                  </div>


                  <label
                    className={
                      styles.agreement
                    }
                  >
                    <input
                      type="checkbox"
                      checked={accepted}
                      onChange={(event) =>
                        setAccepted(
                          event.target.checked,
                        )
                      }
                    />

                    <span>
                      Saya memastikan data yang
                      diisi benar dan memahami
                      dokumen traveler dapat
                      memiliki batas waktu
                      berbeda sesuai jenis paket
                      dan kebijakan Travel.
                    </span>
                  </label>

                </article>
              </>
            )}


            {step === 5 && (
              <>
                <article
                  className={
                    styles.card
                  }
                >
                  <div
                    className={
                      styles.cardHeading
                    }
                  >
                    <ShieldCheck size={20} />

                    <div>
                      <h2>
                        Pembayaran
                      </h2>

                      <p>
                        Pilih skema pembayaran
                        dan metode yang akan
                        digunakan.
                      </p>
                    </div>
                  </div>


                  <div
                    className={
                      styles.paymentPlans
                    }
                  >

                    <button
                      type="button"
                      className={[
                        styles.paymentPlan,
                        paymentPlan === "full"
                          ? styles.paymentPlanActive
                          : "",
                      ].join(" ")}
                      onClick={() =>
                        setPaymentPlan(
                          "full",
                        )
                      }
                    >
                      <strong>
                        Lunas
                      </strong>

                      <span>
                        Bayar seluruh tagihan
                        sekarang.
                      </span>

                      <b>
                        {formatRupiah(
                          estimatedTotal,
                        )}
                      </b>
                    </button>


                    <button
                      type="button"
                      className={[
                        styles.paymentPlan,
                        paymentPlan === "dp"
                          ? styles.paymentPlanActive
                          : "",
                      ].join(" ")}
                      onClick={() =>
                        setPaymentPlan(
                          "dp",
                        )
                      }
                    >
                      <strong>
                        DP 30%
                      </strong>

                      <span>
                        Bayar uang muka,
                        sisa mengikuti jatuh
                        tempo paket.
                      </span>

                      <b>
                        {formatRupiah(
                          Math.ceil(
                            estimatedTotal *
                              0.3,
                          ),
                        )}
                      </b>
                    </button>


                    <button
                      type="button"
                      className={[
                        styles.paymentPlan,
                        paymentPlan ===
                        "installment"
                          ? styles.paymentPlanActive
                          : "",
                      ].join(" ")}
                      onClick={() =>
                        setPaymentPlan(
                          "installment",
                        )
                      }
                    >
                      <strong>
                        Cicilan
                      </strong>

                      <span>
                        Pembayaran bertahap
                        sesuai jadwal paket.
                      </span>

                      <b>
                        Mulai{" "}
                        {formatRupiah(
                          Math.ceil(
                            estimatedTotal *
                              0.25,
                          ),
                        )}
                      </b>
                    </button>

                  </div>
                </article>


                <article
                  className={
                    styles.card
                  }
                >
                  <h2>
                    Metode Pembayaran
                  </h2>

                  <div
                    className={
                      styles.paymentMethods
                    }
                  >

                    {[
                      [
                        "qris",
                        "QRIS",
                        "Scan QR dari aplikasi bank atau e-wallet.",
                      ],
                      [
                        "virtual-account",
                        "Virtual Account",
                        "Pembayaran melalui nomor VA bank.",
                      ],
                      [
                        "bank-transfer",
                        "Transfer Bank",
                        "Transfer melalui rekening pembayaran.",
                      ],
                      [
                        "ewallet",
                        "E-Wallet",
                        "Pembayaran melalui dompet digital.",
                      ],
                    ].map(
                      ([
                        value,
                        title,
                        description,
                      ]) => (
                        <button
                          key={value}
                          type="button"
                          className={[
                            styles.paymentMethod,
                            paymentMethod ===
                            value
                              ? styles.paymentMethodActive
                              : "",
                          ].join(" ")}
                          onClick={() =>
                            setPaymentMethod(
                              value as PaymentMethod,
                            )
                          }
                        >
                          <span
                            className={
                              styles.optionRadio
                            }
                          >
                            {paymentMethod ===
                              value && (
                              <Check
                                size={13}
                              />
                            )}
                          </span>

                          <span>
                            <strong>
                              {title}
                            </strong>

                            <small>
                              {description}
                            </small>
                          </span>
                        </button>
                      ),
                    )}

                  </div>
                </article>


                <article
                  className={
                    styles.paymentSummary
                  }
                >
                  <div>
                    <span>
                      Estimasi total booking
                    </span>

                    <strong>
                      {estimatedTotal > 0
                        ? formatRupiah(
                            estimatedTotal,
                          )
                        : "Mengikuti harga paket"}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Skema
                    </span>

                    <strong>
                      {paymentPlan === "full"
                        ? "Lunas"
                        : paymentPlan === "dp"
                          ? "DP 30%"
                          : "Cicilan"}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Bayar sekarang
                    </span>

                    <strong
                      className={
                        styles.paymentGrandTotal
                      }
                    >
                      {paymentNow > 0
                        ? formatRupiah(
                            paymentNow,
                          )
                        : "-"}
                    </strong>
                  </div>

                  {paymentPlan !==
                    "full" && (
                    <div>
                      <span>
                        Sisa tagihan
                      </span>

                      <strong>
                        {remainingPayment > 0
                          ? formatRupiah(
                              remainingPayment,
                            )
                          : "-"}
                      </strong>
                    </div>
                  )}

                  <p>
                    Nominal anak, bayi,
                    tipe kamar, diskon,
                    promo, fee pembayaran,
                    dan jadwal cicilan
                    nantinya menggunakan
                    pricing snapshot dari
                    booking asli.
                  </p>
                </article>
              </>
            )}

            <div
              className={
                styles.navigation
              }
            >

              {step > 1 ? (
                <button
                  type="button"
                  className={
                    styles.backButton
                  }
                  onClick={
                    previousStep
                  }
                >
                  <ChevronLeft size={17} />
                  Kembali
                </button>
              ) : (
                <a
                  className={
                    styles.backButton
                  }
                  href={`/paket/${slug}`}
                >
                  <ArrowLeft size={17} />
                  Detail Paket
                </a>
              )}


              {step < 5 ? (
                <button
                  type="button"
                  className={
                    styles.nextButton
                  }
                  disabled={
                    (step === 1 &&
                      !purchaserValid) ||
                    (step === 2 &&
                      !travelerValid)
                  }
                  onClick={nextStep}
                >
                  {step === 4
                    ? "Lanjut ke Pembayaran"
                    : "Lanjutkan"}
                  <ArrowRight size={17} />
                </button>
              ) : (
                <button
                  type="submit"
                  className={
                    styles.nextButton
                  }
                  disabled={!accepted}
                >
                  Bayar Sekarang
                  <ArrowRight size={17} />
                </button>
              )}

            </div>

          </section>


          <aside
            className={
              styles.summary
            }
          >

            <div
              className={
                styles.summaryCard
              }
            >

              <span
                className={
                  styles.summaryEyebrow
                }
              >
                {rule.label}
              </span>

              <h2>
                {packageTitle}
              </h2>

              <div
                className={
                  styles.summaryMeta
                }
              >
                <span>
                  <UsersRound size={15} />
                  {travelerTotal} traveler
                </span>

                <span>
                  <MapPin size={15} />
                  Paket perjalanan
                </span>
              </div>


              <hr />


              <div
                className={
                  styles.summaryTravelers
                }
              >

                <span>
                  Dewasa
                  <strong>
                    {adult}
                  </strong>
                </span>

                <span>
                  Anak
                  <strong>
                    {child}
                  </strong>
                </span>

                <span>
                  Bayi
                  <strong>
                    {infant}
                  </strong>
                </span>

              </div>


              <div
                className={
                  styles.deadlineBox
                }
              >
                <CalendarDays size={18} />

                <div>
                  <strong>
                    Kelengkapan dokumen
                  </strong>

                  <p>
                    {rule.documentMessage}
                  </p>
                </div>
              </div>

            </div>


            <div
              className={
                styles.helpCard
              }
            >
              <ShieldCheck size={19} />

              <div>
                <strong>
                  Data sensitif
                </strong>

                <p>
                  Tahap ini hanya UI/UX.
                  NIK dan dokumen belum
                  disimpan ke database.
                </p>
              </div>
            </div>

          </aside>

        </form>

      </div>

    </main>
  );
}
