"use client";

import {
  ArrowLeft,
  ArrowRight,
  CalendarDays,
  Check,
  FileText,
  ShieldCheck,
  UserRound,
} from "lucide-react";

import {
  useMemo,
  useState,
} from "react";

import {
  getVisaProductBySlug,
} from "@/ui/visa-detail";

type VisaSnapshot = {
  country: string;
  productSlug: string;
  vendorSlug: string;
  applicants: number;
  paymentTerm: "full" | "dp";
  departureDate: string;
  returnDate: string;
};

type VisaBookingClientProps = {
  slug: string;
  snapshot: VisaSnapshot;
};

function formatRupiah(
  value: number,
) {
  return new Intl.NumberFormat(
    "id-ID",
    {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    },
  ).format(value);
}

export function VisaBookingClient({
  slug,
  snapshot,
}: VisaBookingClientProps) {
  const product =
    getVisaProductBySlug(
      snapshot.productSlug || slug,
    );

  const [step, setStep] =
    useState(1);

  const [applicant, setApplicant] =
    useState({
      fullName: "",
      gender: "",
      birthPlace: "",
      birthDate: "",
      nationality: "Indonesia",
      passportNumber: "",
      passportIssueDate: "",
      passportExpiryDate: "",
      email: "",
      phone: "",
      address: "",
      city: "",
      province: "",
      postalCode: "",
      destinationCity: "",
      travelPurpose: "",
      departureDate:
        snapshot.departureDate || "",
      returnDate:
        snapshot.returnDate || "",
    });

  const steps = [
    "Data Pemohon",
    "Dokumen & Keberangkatan",
    "Review Data",
    "Pembayaran",
    "Konfirmasi",
  ];

  const applicants =
    Math.max(
      1,
      snapshot.applicants,
    );

  const unitPrice =
    product?.price ?? 0;

  const totalPrice =
    unitPrice * applicants;

  /*
   * DP HANYA ada jika Vendor memang
   * mengaktifkan depositPolicy.
   *
   * Tidak ada fallback DP.
   * Tidak ada hardcode DP 30%.
   */
  const hasDp =
    product?.depositPolicy?.enabled ===
    true;

  const dpPerApplicant =
    hasDp &&
    product?.depositPolicy
      ? product.depositPolicy.type ===
        "percentage"
        ? Math.round(
            unitPrice *
              (
                product.depositPolicy.value /
                100
              ),
          )
        : Math.min(
            product.depositPolicy.value,
            unitPrice,
          )
      : null;

  const dpTotal =
    dpPerApplicant !== null
      ? dpPerApplicant * applicants
      : null;

  /*
   * Query paymentTerm tidak boleh
   * memaksa DP jika produknya tidak
   * memiliki depositPolicy.
   */
  const paymentTerm:
    | "full"
    | "dp" =
    hasDp &&
    snapshot.paymentTerm === "dp"
      ? "dp"
      : "full";

  const paymentNow =
    paymentTerm === "dp" &&
    dpTotal !== null
      ? dpTotal
      : totalPrice;

  const remaining =
    Math.max(
      0,
      totalPrice - paymentNow,
    );

  const requirements =
    product?.requirements ?? [];

  const documents =
    product?.documents ?? [];

  const applicantValid =
    Boolean(
      applicant.fullName.trim() &&
      applicant.birthDate &&
      applicant.nationality.trim() &&
      applicant.passportNumber.trim(),
    );

  const summaryRows =
    useMemo(
      () => [
        {
          label: "Nama Lengkap",
          value:
            applicant.fullName || "-",
        },
        {
          label: "Tanggal Lahir",
          value:
            applicant.birthDate || "-",
        },
        {
          label: "Nomor Paspor",
          value:
            applicant.passportNumber ||
            "-",
        },
        {
          label: "Kewarganegaraan",
          value:
            applicant.nationality ||
            "-",
        },
      ],
      [applicant],
    );

  if (!product) {
    return (
      <main
        style={{
          minHeight: "70vh",
          padding: "48px 16px",
        }}
      >
        <div
          style={{
            maxWidth: 900,
            margin: "0 auto",
          }}
        >
          <h1>
            Produk Visa tidak ditemukan
          </h1>

          <p>
            Produk yang dipilih belum
            tersedia untuk proses booking.
          </p>
        </div>
      </main>
    );
  }

  function nextStep() {
    if (
      step === 1 &&
      !applicantValid
    ) {
      return;
    }

    setStep(
      (current) =>
        Math.min(
          5,
          current + 1,
        ),
    );

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  function previousStep() {
    setStep(
      (current) =>
        Math.max(
          1,
          current - 1,
        ),
    );

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  return (
    <main className="visa-booking">
      <section className="visa-booking__hero">
        <div className="visa-booking__hero-inner">
          <div className="visa-booking__breadcrumb">
            Visa
            <span>›</span>
            {product.countrySlug}
            <span>›</span>
            {product.title}
          </div>

          <h1>
            {product.countrySlug
              .charAt(0)
              .toUpperCase() +
              product.countrySlug.slice(1)}
          </h1>

          <p>{product.title}</p>
        </div>
      </section>

      <section className="visa-booking__steps">
        {steps.map(
          (title, index) => {
            const number =
              index + 1;

            const done =
              step > number;

            const active =
              step === number;

            return (
              <div
                key={title}
                className={[
                  "visa-booking__step",
                  active
                    ? "is-active"
                    : "",
                  done
                    ? "is-done"
                    : "",
                ].join(" ")}
              >
                <span>
                  {done ? (
                    <Check size={15} />
                  ) : (
                    number
                  )}
                </span>

                <strong>
                  {title}
                </strong>
              </div>
            );
          },
        )}
      </section>

      <div className="visa-booking__layout">
        <section className="visa-booking__content">
          {step === 1 && (
            <article className="visa-booking__card visa-booking__applicant-card">
              <header className="visa-booking__page-heading">
                <h2>Data Pemohon</h2>
                <p>
                  Isi data sesuai dengan paspor dan pastikan semua informasi benar.
                </p>
              </header>

              <section className="visa-booking__form-section">
                <h3>Data Pribadi</h3>

                <div className="visa-booking__form">
                  <label className="full">
                    <span>Nama Lengkap (sesuai paspor) *</span>
                    <input
                      value={applicant.fullName}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          fullName: event.target.value,
                        })
                      }
                      placeholder="Masukkan nama lengkap"
                    />
                  </label>

                  <label>
                    <span>Jenis Kelamin *</span>
                    <select
                      value={applicant.gender}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          gender: event.target.value,
                        })
                      }
                    >
                      <option value="">Pilih jenis kelamin</option>
                      <option value="male">Laki-laki</option>
                      <option value="female">Perempuan</option>
                    </select>
                  </label>

                  <label>
                    <span>Tempat Lahir *</span>
                    <input
                      value={applicant.birthPlace}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          birthPlace: event.target.value,
                        })
                      }
                      placeholder="Contoh: Makassar"
                    />
                  </label>

                  <label>
                    <span>Tanggal Lahir *</span>
                    <input
                      type="date"
                      value={applicant.birthDate}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          birthDate: event.target.value,
                        })
                      }
                    />
                  </label>

                  <label>
                    <span>Kewarganegaraan *</span>
                    <input
                      value={applicant.nationality}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          nationality: event.target.value,
                        })
                      }
                    />
                  </label>

                  <label>
                    <span>Nomor Paspor *</span>
                    <input
                      value={applicant.passportNumber}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          passportNumber: event.target.value,
                        })
                      }
                      placeholder="Masukkan nomor paspor"
                    />
                  </label>

                  <label>
                    <span>Tanggal Terbit Paspor *</span>
                    <input
                      type="date"
                      value={applicant.passportIssueDate}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          passportIssueDate: event.target.value,
                        })
                      }
                    />
                  </label>

                  <label>
                    <span>Tanggal Berlaku Paspor *</span>
                    <input
                      type="date"
                      value={applicant.passportExpiryDate}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          passportExpiryDate: event.target.value,
                        })
                      }
                    />
                  </label>
                </div>
              </section>

              <section className="visa-booking__form-section">
                <h3>Rencana Keberangkatan</h3>

                <div className="visa-booking__form">
                  <label>
                    <span>Negara Tujuan</span>
                    <input
                      value={
                        product.countrySlug
                          .charAt(0)
                          .toUpperCase() +
                        product.countrySlug.slice(1)
                      }
                      readOnly
                    />
                  </label>

                  <label>
                    <span>Kota Tujuan</span>
                    <input
                      value={applicant.destinationCity}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          destinationCity: event.target.value,
                        })
                      }
                      placeholder="Contoh: Beijing"
                    />
                  </label>

                  <label>
                    <span>Tanggal Keberangkatan (Estimasi)</span>
                    <input
                      type="date"
                      value={applicant.departureDate}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          departureDate: event.target.value,
                        })
                      }
                    />
                  </label>

                  <label>
                    <span>Tanggal Kembali (Estimasi)</span>
                    <input
                      type="date"
                      value={applicant.returnDate}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          returnDate: event.target.value,
                        })
                      }
                    />
                  </label>

                  <label className="full">
                    <span>Tujuan Perjalanan *</span>
                    <select
                      value={applicant.travelPurpose}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          travelPurpose: event.target.value,
                        })
                      }
                    >
                      <option value="">Pilih tujuan perjalanan</option>
                      <option value="tourism">Wisata</option>
                      <option value="business">Bisnis</option>
                      <option value="visit">Kunjungan</option>
                      <option value="other">Lainnya</option>
                    </select>
                  </label>
                </div>

                <div className="visa-booking__section-note">
                  <CalendarDays size={18} />
                  <p>
                    Tanggal keberangkatan dan kepulangan bersifat estimasi dan
                    digunakan untuk membantu proses pengajuan Visa.
                  </p>
                </div>
              </section>

              <section className="visa-booking__form-section">
                <h3>Informasi Kontak</h3>

                <div className="visa-booking__form">
                  <label>
                    <span>Email *</span>
                    <input
                      type="email"
                      value={applicant.email}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          email: event.target.value,
                        })
                      }
                      placeholder="nama@email.com"
                    />
                  </label>

                  <label>
                    <span>Nomor Telepon *</span>
                    <input
                      type="tel"
                      value={applicant.phone}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          phone: event.target.value,
                        })
                      }
                      placeholder="+62"
                    />
                  </label>
                </div>

                <div className="visa-booking__section-note">
                  <ShieldCheck size={18} />
                  <p>
                    Pastikan email dan nomor telepon aktif agar informasi proses
                    pengajuan dapat diterima dengan baik.
                  </p>
                </div>
              </section>

              <section className="visa-booking__form-section">
                <h3>Alamat Domisili</h3>

                <div className="visa-booking__form">
                  <label className="full">
                    <span>Alamat Lengkap *</span>
                    <input
                      value={applicant.address}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          address: event.target.value,
                        })
                      }
                      placeholder="Masukkan alamat lengkap"
                    />
                  </label>

                  <label>
                    <span>Kota *</span>
                    <input
                      value={applicant.city}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          city: event.target.value,
                        })
                      }
                      placeholder="Kota"
                    />
                  </label>

                  <label>
                    <span>Provinsi *</span>
                    <input
                      value={applicant.province}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          province: event.target.value,
                        })
                      }
                      placeholder="Provinsi"
                    />
                  </label>

                  <label>
                    <span>Kode Pos *</span>
                    <input
                      inputMode="numeric"
                      value={applicant.postalCode}
                      onChange={(event) =>
                        setApplicant({
                          ...applicant,
                          postalCode: event.target.value,
                        })
                      }
                      placeholder="Kode pos"
                    />
                  </label>
                </div>
              </section>
            </article>
          )}
          {step === 2 && (
            <>
              <article className="visa-booking__card">
                <header className="visa-booking__card-heading">
                  <CalendarDays size={23} />

                  <div>
                    <h2>
                      Dokumen & Keberangkatan
                    </h2>

                    <p>
                      Lengkapi dokumen
                      sesuai produk Visa
                      dan rencana
                      perjalanan.
                    </p>
                  </div>
                </header>

                <div className="visa-booking__dates">
                  <div>
                    <span>
                      Rencana Keberangkatan
                    </span>

                    <strong>
                      {snapshot.departureDate ||
                        "Belum dipilih"}
                    </strong>
                  </div>

                  <div>
                    <span>
                      Rencana Kepulangan
                    </span>

                    <strong>
                      {snapshot.returnDate ||
                        "Belum dipilih"}
                    </strong>
                  </div>
                </div>
              </article>

              {(requirements.length > 0 ||
                documents.length > 0) && (
                <article className="visa-booking__card">
                  <header className="visa-booking__card-heading">
                    <FileText size={23} />

                    <div>
                      <h2>
                        Dokumen Persyaratan
                      </h2>

                      <p>
                        Dokumen mengikuti
                        ketentuan produk
                        yang dipilih.
                      </p>
                    </div>
                  </header>

                  {requirements.length >
                    0 && (
                    <div className="visa-booking__requirements">
                      <h3>
                        Persyaratan
                      </h3>

                      {requirements.map(
                        (item) => (
                          <div
                            key={item}
                          >
                            <Check
                              size={16}
                            />
                            {item}
                          </div>
                        ),
                      )}
                    </div>
                  )}

                  {documents.length >
                    0 && (
                    <div className="visa-booking__requirements">
                      <h3>
                        Dokumen
                      </h3>

                      {documents.map(
                        (item) => (
                          <div
                            key={item}
                          >
                            <FileText
                              size={16}
                            />
                            {item}

                            <button
                              type="button"
                            >
                              Unggah File
                            </button>
                          </div>
                        ),
                      )}
                    </div>
                  )}
                </article>
              )}
            </>
          )}

          {step === 3 && (
            <article className="visa-booking__card">
              <header className="visa-booking__card-heading">
                <ShieldCheck size={23} />

                <div>
                  <h2>
                    Review Data
                  </h2>

                  <p>
                    Periksa kembali data
                    sebelum masuk ke
                    pembayaran.
                  </p>
                </div>
              </header>

              <div className="visa-booking__review">
                {summaryRows.map(
                  (row) => (
                    <div
                      key={row.label}
                    >
                      <span>
                        {row.label}
                      </span>

                      <strong>
                        {row.value}
                      </strong>
                    </div>
                  ),
                )}
              </div>
            </article>
          )}

          {step === 4 && (
            <article className="visa-booking__card">
              <header className="visa-booking__card-heading">
                <ShieldCheck size={23} />

                <div>
                  <h2>
                    Pilih Metode Pembayaran
                  </h2>

                  <p>
                    Selesaikan pembayaran
                    untuk melanjutkan
                    proses pengajuan Visa.
                  </p>
                </div>
              </header>

              <div className="visa-booking__payment-total">
                <span>
                  Total Pembayaran
                </span>

                <strong>
                  {formatRupiah(
                    paymentNow,
                  )}
                </strong>
              </div>

              <div className="visa-booking__price-lines">
                <div>
                  <span>
                    Harga Visa
                    {" "}
                    ({applicants} applicant)
                  </span>

                  <strong>
                    {formatRupiah(
                      totalPrice,
                    )}
                  </strong>
                </div>

                {hasDp &&
                  dpTotal !== null &&
                  paymentTerm ===
                    "dp" && (
                    <div>
                      <span>
                        Down Payment (DP)
                      </span>

                      <strong>
                        {formatRupiah(
                          dpTotal,
                        )}
                      </strong>
                    </div>
                  )}

                <div className="total">
                  <span>
                    Total Pembayaran
                    Saat Ini
                  </span>

                  <strong>
                    {formatRupiah(
                      paymentNow,
                    )}
                  </strong>
                </div>

                {hasDp &&
                  paymentTerm ===
                    "dp" &&
                  remaining > 0 && (
                    <div>
                      <span>
                        Sisa Tagihan
                      </span>

                      <strong>
                        {formatRupiah(
                          remaining,
                        )}
                      </strong>
                    </div>
                  )}
              </div>

              <div className="visa-booking__methods">
                {[
                  "Transfer Bank",
                  "Virtual Account",
                  "E-Wallet",
                  "Kartu Kredit / Debit",
                ].map(
                  (method) => (
                    <button
                      key={method}
                      type="button"
                    >
                      <span />
                      <strong>
                        {method}
                      </strong>
                    </button>
                  ),
                )}
              </div>
            </article>
          )}

          {step === 5 && (
            <article className="visa-booking__card">
              <header className="visa-booking__card-heading">
                <Check size={23} />

                <div>
                  <h2>
                    Konfirmasi Pesanan
                  </h2>

                  <p>
                    Periksa seluruh detail
                    pesanan sebelum
                    menyelesaikan proses.
                  </p>
                </div>
              </header>

              <div className="visa-booking__review">
                {summaryRows.map(
                  (row) => (
                    <div
                      key={row.label}
                    >
                      <span>
                        {row.label}
                      </span>

                      <strong>
                        {row.value}
                      </strong>
                    </div>
                  ),
                )}

                <div>
                  <span>
                    Layanan
                  </span>

                  <strong>
                    {product.title}
                  </strong>
                </div>

                <div>
                  <span>
                    Vendor
                  </span>

                  <strong>
                    {product.vendor.name}
                  </strong>
                </div>

                <div>
                  <span>
                    Total Pembayaran
                    Saat Ini
                  </span>

                  <strong>
                    {formatRupiah(
                      paymentNow,
                    )}
                  </strong>
                </div>
              </div>

              <div className="visa-booking__info">
                <ShieldCheck size={20} />

                <p>
                  {hasDp &&
                  paymentTerm === "dp"
                    ? `Setelah pembayaran DP terkonfirmasi, Anda dapat berkonsultasi dengan tim ${product.vendor.name} dan melanjutkan proses pengajuan Visa.`
                    : `Setelah pembayaran terkonfirmasi, Anda dapat berkonsultasi dengan tim ${product.vendor.name} dan melanjutkan proses pengajuan Visa.`}
                </p>
              </div>
            </article>
          )}

          <div className="visa-booking__navigation">
            {step > 1 ? (
              <button
                type="button"
                className="secondary"
                onClick={
                  previousStep
                }
              >
                <ArrowLeft
                  size={17}
                />
                Kembali
              </button>
            ) : (
              <a
                className="secondary"
                href={`/visa/${product.countrySlug}/${product.slug}?vendor=${product.vendor.slug}`}
              >
                <ArrowLeft
                  size={17}
                />
                Kembali
              </a>
            )}

            {step < 5 ? (
              <button
                type="button"
                className="primary"
                disabled={
                  step === 1 &&
                  !applicantValid
                }
                onClick={nextStep}
              >
                {step === 3
                  ? "Lanjutkan ke Pembayaran"
                  : "Lanjutkan"}

                <ArrowRight
                  size={17}
                />
              </button>
            ) : (
              <button
                type="button"
                className="primary"
              >
                Konfirmasi & Selesaikan Pesanan
                <ArrowRight
                  size={17}
                />
              </button>
            )}
          </div>
        </section>

        <aside className="visa-booking__sidebar">
          <article className="visa-booking__summary">
            <h2>Ringkasan Layanan</h2>

            <div className="visa-booking__service">
              <img
                src={`/images/visa/countries/${product.countrySlug}.jpg`}
                alt={product.title}
              />

              <div>
                <span>
                  {product.countrySlug
                    .charAt(0)
                    .toUpperCase() +
                    product.countrySlug.slice(1)}
                </span>

                <h3>{product.title}</h3>

                <p>{product.vendor.name}</p>
              </div>
            </div>

            <div className="visa-booking__service-facts">
              {product.entryType ? (
                <div>
                  <span>Tipe Masuk</span>
                  <strong>{product.entryType}</strong>
                </div>
              ) : null}

              <div>
                <span>Masa Berlaku</span>
                <strong>{product.validity}</strong>
              </div>

              <div>
                <span>Maks. Tinggal</span>
                <strong>{product.stayDuration}</strong>
              </div>

              <div>
                <span>Waktu Proses</span>
                <strong>{product.processTime}</strong>
              </div>

              {product.purpose ? (
                <div>
                  <span>Tujuan</span>
                  <strong>{product.purpose}</strong>
                </div>
              ) : null}
            </div>

            <div className="visa-booking__summary-price">
              <div>
                <span>
                  Harga Visa ({applicants} pemohon)
                </span>

                <strong>
                  {formatRupiah(totalPrice)}
                </strong>
              </div>

              {hasDp &&
              dpTotal !== null &&
              paymentTerm === "dp" ? (
                <div>
                  <span>Down Payment (DP)</span>

                  <strong>
                    {formatRupiah(dpTotal)}
                  </strong>
                </div>
              ) : null}

              <div className="total">
                <span>
                  Total Pembayaran Saat Ini
                </span>

                <strong>
                  {formatRupiah(paymentNow)}
                </strong>
              </div>
            </div>

            <div className="visa-booking__consultation">
              <ShieldCheck size={18} />

              <p>
                {hasDp && paymentTerm === "dp"
                  ? `Setelah pembayaran DP terkonfirmasi, Anda dapat berkonsultasi dengan tim ${product.vendor.name} dan melanjutkan proses pengajuan Visa.`
                  : `Setelah pembayaran terkonfirmasi, Anda dapat berkonsultasi dengan tim ${product.vendor.name} dan melanjutkan proses pengajuan Visa.`}
              </p>
            </div>

            <div className="visa-booking__secure">
              <ShieldCheck size={15} />

              <span>
                Data Anda diproses dengan aman melalui Segaloka.
              </span>
            </div>
          </article>
        </aside>
      </div>
    </main>
  );
}